1\/revisions\/19274"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/abadis-med.com\/wp-json\/wp\/v2\/media\/19273"}],"wp:attachment":[{"href":"https:\/\/abadis-med.com\/wp-json\/wp\/v2\/media?parent=19271"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/abadis-med.com\/wp-json\/wp\/v2\/categories?post=19271"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/abadis-med.com\/wp-json\/wp\/v2\/tags?post=19271"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":19204,"date":"2026-09-05T12:00:44","date_gmt":"2026-09-05T12:00:44","guid":{"rendered":"https:\/\/abadis-med.com\/?p=19204"},"modified":"2026-09-05T12:00:44","modified_gmt":"2026-09-05T12:00:44","slug":"%d8%a2%d8%a8%d8%a7%d8%af%db%8c%d8%b3-%d9%be%db%8c%d8%b4%d9%86%d9%87%d8%a7%d8%af%d9%87%d8%a7%db%8c-%d8%ac%d8%a7%d9%85%d8%b9-%d8%ae%d9%88%d8%af-%d8%a8%d8%b1%d8%a7%db%8c-%d8%a7%d8%b5%d9%84%d8%a7%d8%ad","status":"publish","type":"post","link":"https:\/\/abadis-med.com\/%d8%a2%d8%a8%d8%a7%d8%af%db%8c%d8%b3-%d9%be%db%8c%d8%b4%d9%86%d9%87%d8%a7%d8%af%d9%87%d8%a7%db%8c-%d8%ac%d8%a7%d9%85%d8%b9-%d8%ae%d9%88%d8%af-%d8%a8%d8%b1%d8%a7%db%8c-%d8%a7%d8%b5%d9%84%d8%a7%d8%ad\/","title":{"rendered":"\u0622\u0628\u0627\u062f\u06cc\u0633 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0647\u0627\u06cc \u062c\u0627\u0645\u0639 \u062e\u0648\u062f \u0628\u0631\u0627\u06cc \u0627\u0635\u0644\u0627\u062d \u0627\u0633\u0627\u0633\u0646\u0627\u0645\u0647 \u0627\u0646\u062c\u0645\u0646 \u062a\u0648\u0644\u06cc\u062f \u0631\u0627 \u0627\u0631\u0627\u0626\u0647 \u06a9\u0631\u062f"},"content":{"rendered":"<div dir=\"rtl\">\u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633\u060c \u062f\u0631 \u067e\u0627\u0633\u062e \u0628\u0647 \u0641\u0631\u0627\u062e\u0648\u0627\u0646 \u0627\u0646\u062c\u0645\u0646 \u0635\u0646\u0641\u06cc \u06a9\u0627\u0631\u0641\u0631\u0645\u0627\u06cc\u06cc \u062a\u0648\u0644\u06cc\u062f\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u0648 \u0635\u0627\u062f\u0631\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u0648 \u0645\u0644\u0632\u0648\u0645\u0627\u062a \u067e\u0632\u0634\u06a9\u06cc\u060c \u062f\u0646\u062f\u0627\u0646\u067e\u0632\u0634\u06a9\u06cc\u060c \u0622\u0632\u0645\u0627\u06cc\u0634\u06af\u0627\u0647\u06cc \u0648 \u062f\u0627\u0631\u0648\u06cc\u06cc\u060c \u0645\u062c\u0645\u0648\u0639\u0647\u200c\u0627\u06cc \u062c\u0627\u0645\u0639 \u0627\u0632 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0647\u0627\u06cc \u0627\u0635\u0644\u0627\u062d\u06cc \u062e\u0648\u062f \u0631\u0627 \u0628\u0627 \u0647\u062f\u0641 \u062a\u0642\u0648\u06cc\u062a \u0645\u0634\u0627\u0631\u06a9\u062a \u0627\u0639\u0636\u0627\u060c \u0635\u06cc\u0627\u0646\u062a \u0627\u0632 \u062d\u0642 \u0631\u0623\u06cc \u062a\u0648\u0644\u06cc\u062f\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u0648\u0627\u0642\u0639\u06cc\u060c \u0627\u0641\u0632\u0627\u06cc\u0634 \u0634\u0641\u0627\u0641\u06cc\u062a \u0648 \u0628\u0647\u0628\u0648\u062f \u0633\u0627\u062e\u062a\u0627\u0631 \u062d\u06a9\u0645\u0631\u0627\u0646\u06cc \u0627\u0646\u062c\u0645\u0646 \u0627\u0631\u0627\u0626\u0647 \u06a9\u0631\u062f.<\/div>\n<div dir=\"rtl\">\u0622\u0628\u0627\u062f\u06cc\u0633 \u067e\u06cc\u0634 \u0627\u0632 \u0627\u06cc\u0646\u060c \u0637\u06cc \u0646\u0627\u0645\u0647\u200c\u0627\u06cc \u0631\u0633\u0645\u06cc \u0648 \u0628\u0627 \u0627\u0634\u0627\u0631\u0647 \u0628\u0647 \u0646\u0628\u0648\u062f \u0634\u0641\u0627\u0641\u06cc\u062a \u0648 \u067e\u0627\u0633\u062e\u200c\u06af\u0648\u06cc\u06cc \u06a9\u0627\u0641\u06cc\u060c \u0636\u0639\u0641 \u062f\u0631 \u0646\u062a\u06cc\u062c\u0647\u200c\u0645\u062d\u0648\u0631\u06cc \u0648 \u06a9\u0627\u0647\u0634 \u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0639\u0636\u0627\u060c \u062a\u0635\u0645\u06cc\u0645 \u062e\u0648\u062f \u0645\u0628\u0646\u06cc \u0628\u0631 <strong><a href=\"https:\/\/abadis-med.com\/%d8%a7%d8%b9%d9%84%d8%a7%d9%85-%d8%b9%d8%af%d9%85-%d8%aa%d9%85%d8%af%db%8c%d8%af-%d8%b9%d8%b6%d9%88%db%8c%d8%aa-%d9%88-%d8%a7%d9%86%d8%aa%d8%b4%d8%a7%d8%b1-%d9%86%d8%a7%d9%85%d9%87-%d8%b3%d8%b1%da%af\/\">\u0639\u062f\u0645 \u062a\u0645\u062f\u06cc\u062f \u0639\u0636\u0648\u06cc\u062a<\/a><\/strong> \u0648 \u0627\u0646\u0635\u0631\u0627\u0641 \u0627\u0632 \u0627\u062f\u0627\u0645\u0647 \u062d\u0636\u0648\u0631 \u062f\u0631 \u0627\u0646\u062c\u0645\u0646 \u0631\u0627 \u0627\u0639\u0644\u0627\u0645 \u06a9\u0631\u062f\u0647 \u0628\u0648\u062f.<\/div>\n<div dir=\"rtl\">\u0628\u0627\u0627\u06cc\u0646\u200c\u062d\u0627\u0644\u060c \u067e\u0633 \u0627\u0632 \u062a\u0645\u0627\u0633\u200c\u0647\u0627 \u0648 \u0627\u0635\u0631\u0627\u0631 \u062a\u0639\u062f\u0627\u062f\u06cc \u0627\u0632 \u0627\u0639\u0636\u0627\u06cc \u0647\u06cc\u0626\u062a\u200c\u0645\u062f\u06cc\u0631\u0647 \u0648 \u0645\u0633\u0626\u0648\u0644\u0627\u0646 \u0627\u0646\u062c\u0645\u0646 \u0628\u0631\u0627\u06cc \u0627\u062f\u0627\u0645\u0647 \u062d\u0636\u0648\u0631 \u0648 \u0645\u0634\u0627\u0631\u06a9\u062a \u0622\u0628\u0627\u062f\u06cc\u0633 \u062f\u0631 \u0645\u0633\u06cc\u0631 \u0627\u0635\u0644\u0627\u062d\u060c \u0627\u06cc\u0646 \u0634\u0631\u06a9\u062a \u0628\u0627 \u0627\u0645\u06cc\u062f \u0628\u0647 \u0641\u0631\u0627\u0647\u0645\u200c\u0634\u062f\u0646 \u0632\u0645\u06cc\u0646\u0647 \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0648\u0627\u0642\u0639\u06cc \u0648 \u0633\u0627\u062e\u062a\u0627\u0631\u06cc\u060c \u0647\u0645\u0686\u0646\u0627\u0646 \u0639\u0636\u0648 \u0627\u0646\u062c\u0645\u0646 \u0628\u0627\u0642\u06cc \u0645\u0627\u0646\u062f \u0648 \u062a\u0635\u0645\u06cc\u0645 \u06af\u0631\u0641\u062a \u0628\u0627\u0631 \u062f\u06cc\u06af\u0631 \u0645\u0633\u06cc\u0631 \u06af\u0641\u062a\u200c\u0648\u06af\u0648 \u0648 \u0627\u0635\u0644\u0627\u062d \u0627\u0632 \u062f\u0631\u0648\u0646 \u0631\u0627 \u062f\u0646\u0628\u0627\u0644 \u06a9\u0646\u062f.<\/div>\n<div dir=\"rtl\">\u062a\u062f\u0627\u0648\u0645 \u0639\u0636\u0648\u06cc\u062a \u0622\u0628\u0627\u062f\u06cc\u0633 \u0628\u0647 \u0645\u0639\u0646\u0627\u06cc \u0639\u062f\u0648\u0644 \u0627\u0632 \u0646\u0642\u062f\u0647\u0627\u06cc \u06af\u0630\u0634\u062a\u0647 \u0646\u06cc\u0633\u062a\u061b \u0628\u0644\u06a9\u0647 \u0646\u0634\u0627\u0646\u200c\u062f\u0647\u0646\u062f\u0647 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a\u200c\u067e\u0630\u06cc\u0631\u06cc \u0627\u06cc\u0646 \u0634\u0631\u06a9\u062a \u062f\u0631 \u0642\u0628\u0627\u0644 \u0635\u0646\u0641 \u0648 \u0641\u0631\u0627\u0647\u0645\u200c\u06a9\u0631\u062f\u0646 \u0641\u0631\u0635\u062a\u06cc \u062f\u0648\u0628\u0627\u0631\u0647 \u0628\u0631\u0627\u06cc \u0627\u0635\u0644\u0627\u062d \u0633\u0627\u062e\u062a\u0627\u0631\u0647\u0627\u060c \u0628\u0627\u0632\u0633\u0627\u0632\u06cc \u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0639\u0636\u0627 \u0648 \u0627\u0641\u0632\u0627\u06cc\u0634 \u0627\u062b\u0631\u0628\u062e\u0634\u06cc \u0627\u0646\u062c\u0645\u0646 \u0627\u0633\u062a.<\/div>\n<div dir=\"rtl\">\u062f\u0631 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0647\u0627\u06cc \u0627\u0631\u0627\u0626\u0647\u200c\u0634\u062f\u0647\u060c \u0645\u0648\u0636\u0648\u0639\u0627\u062a\u06cc \u0627\u0632 \u062c\u0645\u0644\u0647 \u0639\u0636\u0648\u06cc\u062a \u0641\u0631\u0627\u06af\u06cc\u0631 \u0641\u0639\u0627\u0644\u0627\u0646 \u0635\u0646\u0639\u062a\u060c \u0627\u062e\u062a\u0635\u0627\u0635 \u062d\u0642 \u0631\u0623\u06cc \u0648 \u062d\u0642 \u0646\u0627\u0645\u0632\u062f\u06cc \u0628\u0647 \u062a\u0648\u0644\u06cc\u062f\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u062f\u0627\u0631\u0627\u06cc \u067e\u0631\u0648\u0627\u0646\u0647 \u0628\u0647\u0631\u0647\u200c\u0628\u0631\u062f\u0627\u0631\u06cc \u0648 \u067e\u0631\u0648\u0627\u0646\u0647 \u062a\u0648\u0644\u06cc\u062f \u0645\u0639\u062a\u0628\u0631\u060c \u0627\u062c\u0631\u0627\u06cc \u0627\u0635\u0644 \u00ab\u0647\u0631 \u06af\u0631\u0648\u0647 \u0627\u0642\u062a\u0635\u0627\u062f\u06cc\u060c \u06cc\u06a9 \u0631\u0623\u06cc\u00bb\u060c \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 \u062a\u062c\u0645\u06cc\u0639 \u0648 \u0645\u0647\u0646\u062f\u0633\u06cc \u0622\u0631\u0627 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0634\u0631\u06a9\u062a\u200c\u0647\u0627\u06cc \u0648\u0627\u0628\u0633\u062a\u0647\u060c \u062a\u0639\u06cc\u06cc\u0646 \u0646\u0645\u0627\u06cc\u0646\u062f\u06af\u0627\u0646 \u0645\u062c\u0627\u0632 \u0634\u0631\u06a9\u062a\u200c\u0647\u0627\u060c \u0634\u0641\u0627\u0641\u200c\u0633\u0627\u0632\u06cc \u0641\u0647\u0631\u0633\u062a \u0648\u0627\u062c\u062f\u0627\u0646 \u0631\u0623\u06cc\u060c \u062a\u0634\u06a9\u06cc\u0644 \u06a9\u0645\u06cc\u062a\u0647 \u0645\u0633\u062a\u0642\u0644 \u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a\u060c \u0627\u0635\u0644\u0627\u062d \u0646\u0635\u0627\u0628 \u0645\u062c\u0627\u0645\u0639\u060c \u0634\u0641\u0627\u0641\u06cc\u062a \u0645\u0627\u0644\u06cc\u060c \u0645\u062f\u06cc\u0631\u06cc\u062a \u062a\u0639\u0627\u0631\u0636 \u0645\u0646\u0627\u0641\u0639 \u0648 \u062a\u0636\u0645\u06cc\u0646 \u062d\u0642\u0648\u0642 \u0627\u0639\u0636\u0627 \u0645\u0648\u0631\u062f \u062a\u0648\u062c\u0647 \u0642\u0631\u0627\u0631 \u06af\u0631\u0641\u062a\u0647 \u0627\u0633\u062a.<\/div>\n<div dir=\"rtl\">\u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633 \u0627\u0645\u06cc\u062f\u0648\u0627\u0631 \u0627\u0633\u062a \u0641\u0631\u0627\u062e\u0648\u0627\u0646 \u0627\u0635\u0644\u0627\u062d \u0627\u0633\u0627\u0633\u0646\u0627\u0645\u0647\u060c \u0622\u063a\u0627\u0632\u06af\u0631 \u062a\u063a\u06cc\u06cc\u0631\u06cc \u0648\u0627\u0642\u0639\u06cc \u0648 \u0642\u0627\u0628\u0644\u200c\u0627\u0646\u062f\u0627\u0632\u0647\u200c\u06af\u06cc\u0631\u06cc \u062f\u0631 \u0627\u0646\u062c\u0645\u0646 \u0628\u0627\u0634\u062f \u0648 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0647\u0627\u06cc \u0627\u0639\u0636\u0627 \u067e\u0633 \u0627\u0632 \u0628\u0631\u0631\u0633\u06cc \u06a9\u0627\u0631\u0634\u0646\u0627\u0633\u06cc\u060c \u0628\u0647 \u062a\u0635\u0645\u06cc\u0645\u0627\u062a \u0627\u062c\u0631\u0627\u06cc\u06cc \u0648 \u0627\u0635\u0644\u0627\u062d\u0627\u062a \u0645\u0624\u062b\u0631 \u0645\u0646\u062a\u0647\u06cc \u0634\u0648\u062f.<\/div>\n<div dir=\"rtl\">\u0622\u0628\u0627\u062f\u06cc\u0633 \u0647\u0645\u0686\u0646\u0627\u0646 \u0622\u0631\u0632\u0648\u0645\u0646\u062f \u0634\u06a9\u0644\u200c\u06af\u06cc\u0631\u06cc \u0627\u0646\u062c\u0645\u0646\u06cc \u0634\u0641\u0627\u0641\u060c \u067e\u0627\u0633\u062e\u200c\u06af\u0648\u060c \u0645\u0633\u062a\u0642\u0644\u060c \u0641\u0631\u0627\u06af\u06cc\u0631 \u0648 \u0642\u062f\u0631\u062a\u0645\u0646\u062f \u0627\u0633\u062a\u061b \u0627\u0646\u062c\u0645\u0646\u06cc \u06a9\u0647 \u0635\u062f\u0627\u06cc \u0647\u0645\u0647 \u0627\u0639\u0636\u0627 \u0631\u0627 \u0628\u0634\u0646\u0648\u062f \u0648 \u0628\u062a\u0648\u0627\u0646\u062f \u0628\u0627 \u0627\u062a\u06a9\u0627 \u0628\u0647 \u0627\u0639\u062a\u0645\u0627\u062f \u0648 \u0645\u0634\u0627\u0631\u06a9\u062a \u062a\u0648\u0644\u06cc\u062f\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u0648\u0627\u0642\u0639\u06cc\u060c \u0627\u0632 \u0645\u0646\u0627\u0641\u0639 \u0635\u0646\u0639\u062a \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u067e\u0632\u0634\u06a9\u06cc \u06a9\u0634\u0648\u0631 \u062f\u0641\u0627\u0639 \u06a9\u0646\u062f.<\/div>\n<div dir=\"rtl\"><\/div>\n<div dir=\"rtl\">\u0628\u0631\u0627\u06cc \u0645\u0634\u0627\u0647\u062f\u0647 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f \u0647\u0627\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633 \u0628\u0647 \u0627\u0635\u0644\u0627\u062d \u0627\u0633\u0627\u0633\u0646\u0627\u0645\u0647 \u0628\u0647 \u0627\u06cc\u0646 <strong><a href=\"https:\/\/abadis-med.com\/wp-content\/uploads\/2026\/09\/\u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0647\u0627\u06cc-\u0622\u0628\u0627\u062f\u06cc\u0633-\u0627\u0633\u0627\u0633\u0646\u0627\u0645\u0647-\u0627\u0646\u062c\u0645\u0646-AMEDAL.pdf\">\u0644\u06cc\u0646\u06a9 <\/a><\/strong>\u0645\u0631\u0627\u062c\u0639\u0647 \u0646\u0645\u0627\u06cc\u06cc\u062f.<\/div>\n","protected":false},"excerpt":{"rendered":"<p>\u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633\u060c \u062f\u0631 \u067e\u0627\u0633\u062e \u0628\u0647 \u0641\u0631\u0627\u062e\u0648\u0627\u0646 \u0627\u0646\u062c\u0645\u0646 \u0635\u0646\u0641\u06cc \u06a9\u0627\u0631\u0641\u0631\u0645\u0627\u06cc\u06cc \u062a\u0648\u0644\u06cc\u062f\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u0648 \u0635\u0627\u062f\u0631\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u0648 \u0645\u0644\u0632\u0648\u0645\u0627\u062a \u067e\u0632\u0634\u06a9\u06cc\u060c \u062f\u0646\u062f\u0627\u0646\u067e\u0632\u0634\u06a9\u06cc\u060c \u0622\u0632\u0645\u0627\u06cc\u0634\u06af\u0627\u0647\u06cc \u0648 \u062f\u0627\u0631\u0648\u06cc\u06cc\u060c \u0645\u062c\u0645\u0648\u0639\u0647\u200c\u0627\u06cc \u062c\u0627\u0645\u0639 \u0627\u0632 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0647\u0627\u06cc \u0627\u0635\u0644\u0627\u062d\u06cc \u062e\u0648\u062f \u0631\u0627 \u0628\u0627 \u0647\u062f\u0641 \u062a\u0642\u0648\u06cc\u062a \u0645\u0634\u0627\u0631\u06a9\u062a \u0627\u0639\u0636\u0627\u060c \u0635\u06cc\u0627\u0646\u062a \u0627\u0632 \u062d\u0642 \u0631\u0623\u06cc \u062a\u0648\u0644\u06cc\u062f\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u0648\u0627\u0642\u0639\u06cc\u060c \u0627\u0641\u0632\u0627\u06cc\u0634 \u0634\u0641\u0627\u0641\u06cc\u062a \u0648 \u0628\u0647\u0628\u0648\u062f \u0633\u0627\u062e\u062a\u0627\u0631 \u062d\u06a9\u0645\u0631\u0627\u0646\u06cc \u0627\u0646\u062c\u0645\u0646 \u0627\u0631\u0627\u0626\u0647 \u06a9\u0631\u062f. \u0622\u0628\u0627\u062f\u06cc\u0633 \u067e\u06cc\u0634 \u0627\u0632 \u0627\u06cc\u0646\u060c \u0637\u06cc [&hellip;]<\/p>\n","protected":false},"author":6,"featured_media":19206,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[22],"tags":[],"class_list":["post-19204","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-newss"],"acf":[],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v19.5 (Yoast SEO v19.10) - https:\/\/yoast.com\/wordpress\/plugins\/seo\/ -->\n<title>\u0622\u0628\u0627\u062f\u06cc\u0633 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0647\u0627\u06cc \u062c\u0627\u0645\u0639 \u062e\u0648\u062f \u0628\u0631\u0627\u06cc \u0627\u0635\u0644\u0627\u062d \u0627\u0633\u0627\u0633\u0646\u0627\u0645\u0647 \u0627\u0646\u062c\u0645\u0646 \u062a\u0648\u0644\u06cc\u062f \u0631\u0627 \u0627\u0631\u0627\u0626\u0647 \u06a9\u0631\u062f &raquo; \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/abadis-med.com\/\u0622\u0628\u0627\u062f\u06cc\u0633-\u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0647\u0627\u06cc-\u062c\u0627\u0645\u0639-\u062e\u0648\u062f-\u0628\u0631\u0627\u06cc-\u0627\u0635\u0644\u0627\u062d\/\" \/>\n<meta property=\"og:locale\" content=\"fa_IR\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"\u0622\u0628\u0627\u062f\u06cc\u0633 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0647\u0627\u06cc \u062c\u0627\u0645\u0639 \u062e\u0648\u062f \u0628\u0631\u0627\u06cc \u0627\u0635\u0644\u0627\u062d \u0627\u0633\u0627\u0633\u0646\u0627\u0645\u0647 \u0627\u0646\u062c\u0645\u0646 \u062a\u0648\u0644\u06cc\u062f \u0631\u0627 \u0627\u0631\u0627\u0626\u0647 \u06a9\u0631\u062f &raquo; \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633\" \/>\n<meta property=\"og:description\" content=\"\u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633\u060c \u062f\u0631 \u067e\u0627\u0633\u062e \u0628\u0647 \u0641\u0631\u0627\u062e\u0648\u0627\u0646 \u0627\u0646\u062c\u0645\u0646 \u0635\u0646\u0641\u06cc \u06a9\u0627\u0631\u0641\u0631\u0645\u0627\u06cc\u06cc \u062a\u0648\u0644\u06cc\u062f\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u0648 \u0635\u0627\u062f\u0631\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u0648 \u0645\u0644\u0632\u0648\u0645\u0627\u062a \u067e\u0632\u0634\u06a9\u06cc\u060c \u062f\u0646\u062f\u0627\u0646\u067e\u0632\u0634\u06a9\u06cc\u060c \u0622\u0632\u0645\u0627\u06cc\u0634\u06af\u0627\u0647\u06cc \u0648 \u062f\u0627\u0631\u0648\u06cc\u06cc\u060c \u0645\u062c\u0645\u0648\u0639\u0647\u200c\u0627\u06cc \u062c\u0627\u0645\u0639 \u0627\u0632 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0647\u0627\u06cc \u0627\u0635\u0644\u0627\u062d\u06cc \u062e\u0648\u062f \u0631\u0627 \u0628\u0627 \u0647\u062f\u0641 \u062a\u0642\u0648\u06cc\u062a \u0645\u0634\u0627\u0631\u06a9\u062a \u0627\u0639\u0636\u0627\u060c \u0635\u06cc\u0627\u0646\u062a \u0627\u0632 \u062d\u0642 \u0631\u0623\u06cc \u062a\u0648\u0644\u06cc\u062f\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u0648\u0627\u0642\u0639\u06cc\u060c \u0627\u0641\u0632\u0627\u06cc\u0634 \u0634\u0641\u0627\u0641\u06cc\u062a \u0648 \u0628\u0647\u0628\u0648\u062f \u0633\u0627\u062e\u062a\u0627\u0631 \u062d\u06a9\u0645\u0631\u0627\u0646\u06cc \u0627\u0646\u062c\u0645\u0646 \u0627\u0631\u0627\u0626\u0647 \u06a9\u0631\u062f. \u0622\u0628\u0627\u062f\u06cc\u0633 \u067e\u06cc\u0634 \u0627\u0632 \u0627\u06cc\u0646\u060c \u0637\u06cc [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/abadis-med.com\/\u0622\u0628\u0627\u062f\u06cc\u0633-\u067e\u06cc\u0634\u0646\u0647\