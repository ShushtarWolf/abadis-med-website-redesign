647\u062f \u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633 \u0628\u0647 \u0627\u0647\u062f\u0627\u0641 \u062a\u0648\u0633\u0639\u0647 \u067e\u0627\u06cc\u062f\u0627\u0631 \u0633\u0627\u0632\u0645\u0627\u0646 \u0645\u0644\u0644 (UN SDGs) \u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633\u060c \u0628\u0647\u200c\u0639\u0646\u0648\u0627\u0646 \u067e\u06cc\u0634\u0631\u0648 \u062f\u0631 \u062a\u0648\u0644\u06cc\u062f \u06a9\u06cc\u0633\u0647\u200c\u0647\u0627\u06cc \u0633\u0627\u06a9\u0634\u0646 \u06cc\u06a9\u200c\u0628\u0627\u0631\u0645\u0635\u0631\u0641 \u062f\u0631 \u0627\u06cc\u0631\u0627\u0646\u060c \u0645\u062a\u0639\u0647\u062f \u0627\u0633\u062a \u0641\u0639\u0627\u0644\u06cc\u062a\u200c\u0647\u0627\u06cc \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u0631\u0627\u0633\u062a\u0627\u06cc \u0627\u0647\u062f\u0627\u0641 \u062a\u0648\u0633\u0639\u0647 \u067e\u0627\u06cc\u062f\u0627\u0631 \u0633\u0627\u0632\u0645\u0627\u0646 \u0645\u0644\u0644 \u0645\u062a\u062d\u062f (UN SDGs) \u0647\u062f\u0627\u06cc\u062a \u06a9\u0646\u062f.\u0645\u0627 \u0628\u0627\u0648\u0631 \u062f\u0627\u0631\u06cc\u0645 \u06a9\u0647 \u062a\u0648\u0633\u0639\u0647 \u0635\u0646\u0639\u062a\u06cc \u062a\u0646\u0647\u0627 \u0632\u0645\u0627\u0646\u06cc \u0627\u0631\u0632\u0634\u0645\u0646\u062f \u0627\u0633\u062a [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/abadis-med.com\/\u062a\u0648\u0633\u0639\u0647-\u067e\u0627\u06cc\u062f\u0627\u0631\/\" \/>\n<meta property=\"og:site_name\" content=\"\u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633\" \/>\n<meta property=\"article:publisher\" content=\"https:\/\/www.facebook.com\/AbadisMedCo\/\" \/>\n<meta property=\"article:modified_time\" content=\"2025-11-20