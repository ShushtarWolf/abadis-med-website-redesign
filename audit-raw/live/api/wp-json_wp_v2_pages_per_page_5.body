09Industry.svg.png 1200w\" sizes=\"auto, (max-width: 800px) 100vw, 800px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-14 elementor-inner-column elementor-element elementor-element-d2cde35\" data-id=\"d2cde35\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-a08215d dce_masking-none elementor-widget elementor-widget-image\" data-id=\"a08215d\" data-element_type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"800\" height=\"800\" src=\"https:\/\/abadis-med.com\/wp-content\/uploads\/2025\/10\/E_SDG-goals_icons-individual-rgb-12-1024x1024.png\" class=\"attachment-large size-large wp-image-18157\" alt=\"\" srcset=\"https:\/\/abadis-med.com\/wp-content\/uploads\/2025\/10\/E_SDG-goals_icons-individual-rgb-12-1024x1024.png 1024w, https:\/\/abadis-med.com\/wp-content\/uploads\/2025\/10\/E_SDG-goals_icons-individual-rgb-12-300x300.png 300w, https:\/\/abadis-med.com\/wp-content\/uploads\/2025\/10\/E_SDG-goals_icons-individual-rgb-12-150x150.png 150w, https:\/\/abadis-med.com\/wp-content\/uploads\/2025\/10\/E_SDG-goals_icons-individual-rgb-12-768x768.png 768w, https:\/\/abadis-med.com\/wp-content\/uploads\/2025\/10\/E_SDG-goals_icons-individual-rgb-12.png 1536w\" sizes=\"auto, (max-width: 800px) 100vw, 800px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-14 elementor-inner-column elementor-element elementor-element-24e6691\" data-id=\"24e6691\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-3957e1d dce_masking-none elementor-widget elementor-widget-image\" data-id=\"3957e1d\" data-element_type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"800\" height=\"800\" src=\"https:\/\/abadis-med.com\/wp-content\/uploads\/2025\/10\/Sustainable_Development_Goal_13Climate.svg-1024x1024.png\" class=\"attachment-large size-large wp-image-18158\" alt=\"\" srcset=\"https:\/\/abadis-med.com\/wp-content\/uploads\/2025\/10\/Sustainable_Development_Goal_13Climate.svg-1024x1024.png 1024w, https:\/\/abadis-med.com\/wp-content\/uploads\/2025\/10\/Sustainable_Development_Goal_13Climate.svg-300x300.png 300w, https:\/\/abadis-med.com\/wp-content\/uploads\/2025\/10\/Sustainable_Development_Goal_13Climate.svg-150x150.png 150w, https:\/\/abadis-med.com\/wp-content\/uploads\/2025\/10\/Sustainable_Development_Goal_13Climate.svg-768x768.png 768w, https:\/\/abadis-med.com\/wp-content\/uploads\/2025\/10\/Sustainable_Development_Goal_13Climate.svg.png 1200w\" sizes=\"auto, (max-width: 800px) 100vw, 800px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-eb8a0a5 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"eb8a0a5\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-inner-column elementor-element elementor-element-4225c4e\" data-id=\"4225c4e\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-50d09ff elementor-widget elementor-widget-text-editor\" data-id=\"50d09ff\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<ol><li><strong>\u0633\u0644\u0627\u0645\u062a \u0648 \u062a\u0646\u062f\u0631\u0633\u062a\u06cc<\/strong><strong> (SDG 3)<\/strong><\/li><\/ol><ul><li>\u0628\u0647\u0628\u0648\u062f \u0627\u06cc\u0645\u0646\u06cc \u0628\u06cc\u0645\u0627\u0631\u0627\u0646 \u0648 \u06a9\u0627\u062f\u0631 \u062f\u0631\u0645\u0627\u0646 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u062d\u0630\u0641 \u062a\u0645\u0627\u0633 \u0645\u0633\u062a\u0642\u06cc\u0645 \u0628\u0627 \u0645\u0627\u06cc\u0639\u0627\u062a \u0639\u0641\u0648\u0646\u06cc.<\/li><li>\u0627\u0631\u062a\u0642\u0627\u06cc \u0628\u0647\u062f\u0627\u0634\u062a \u0645\u062d\u06cc\u0637 \u0628\u06cc\u0645\u0627\u0631\u0633\u062a\u0627\u0646 \u0648 \u06a9\u0627\u0647\u0634 \u062e\u0637\u0631 \u0639\u0641\u0648\u0646\u062a\u200c\u0647\u0627\u06cc \u0628\u06cc\u0645\u0627\u0631\u0633\u062a\u0627\u0646\u06cc.<\/li><\/ul><ol start=\"2\"><li><strong>\u0622\u0628 \u067e\u0627\u06a9 \u0648 \u0628\u0647\u062f\u0627\u0634\u062a<\/strong><strong> (SDG 6)<\/strong><\/li><\/ol><ul><li>\u062d\u0630\u0641 \u0641\u0631\u0622\u06cc\u0646\u062f \u0634\u0633\u062a\u200c\u0648\u0634\u0648\u06cc \u0645\u062e\u0627\u0632\u0646 \u0633\u0627\u06a9\u0634\u0646 \u0633\u0646\u062a\u06cc \u0648 \u0635\u0631\u0641\u0647\u200c\u062c\u0648\u06cc\u06cc \u0686\u0634\u0645\u06af\u06cc\u0631 \u062f\u0631 \u0645\u0635\u0631\u0641 \u0622\u0628.<\/li><li>\u0627\u06cc\u0646 \u0635\u0631\u0641\u0647\u200c\u062c\u0648\u06cc\u06cc \u0628\u0647\u200c\u0635\u0648\u0631\u062a <strong>\u0645\u0642\u06cc\u0627\u0633\u200c\u067e\u0630\u06cc\u0631<\/strong> \u0645\u062d\u0627\u0633\u0628\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f: \u0628\u0647 \u0627\u0632\u0627\u06cc \u0647\u0631 \u06a9\u06cc\u0633\u0647 \u0645\u0635\u0631\u0641\u06cc\u060c \u0628\u0647\u200c\u0637\u0648\u0631 \u0645\u06cc\u0627\u0646\u06af\u06cc\u0646 <strong>\u06f2\u06f5<\/strong> <strong>\u0644\u06cc\u062a\u0631 \u0622\u0628 \u0630\u062e\u06cc\u0631\u0647<\/strong> \u0645\u06cc\u200c\u0634\u0648\u062f.<\/li><li>\u0628\u0627 \u062a\u0648\u062c\u0647 \u0628\u0647 \u0645\u0635\u0631\u0641 \u0631\u0648\u0632\u0627\u0646\u0647 \u0647\u0632\u0627\u0631\u0627\u0646 \u06a9\u06cc\u0633\u0647 \u062f\u0631 \u0628\u06cc\u0645\u0627\u0631\u0633\u062a\u0627\u0646\u200c\u0647\u0627\u06cc \u06a9\u0634\u0648\u0631\u060c \u0645\u06cc\u0632\u0627\u0646 \u0635\u0631\u0641\u0647\u200c\u062c\u0648\u06cc\u06cc \u0628\u0647\u200c\u0637\u0648\u0631 \u067e\u06cc\u0648\u0633\u062a\u0647 \u062f\u0631 \u062d\u0627\u0644 \u0627\u0641\u0632\u0627\u06cc\u0634 \u0627\u0633\u062a \u0648 \u062a\u0627 <strong>\u067e\u0627\u06cc\u0627\u0646 \u0633\u0627\u0644 <\/strong><strong>\u06f1\u06f4\u06f0\u06f2<\/strong><strong>\u060c \u0628\u06cc\u0634 \u0627\u0632 <\/strong><strong>\u06f2\u06f8<\/strong><strong> \u0645\u06cc\u0644\u06cc\u0648\u0646 \u0644\u06cc\u062a\u0631 \u0622\u0628<\/strong> \u0627\u0632 \u0645\u0635\u0631\u0641 \u063a\u06cc\u0631\u0636\u0631\u0648\u0631\u06cc \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0634\u062f\u0647 \u0648 \u062f\u0631 \u0633\u0627\u0644\u200c\u0647\u0627\u06cc \u0627\u062e\u06cc\u0631 \u0628\u0647 <strong>\u0645\u06cc\u0627\u0646\u06af\u06cc\u0646 \u0635\u0631\u0641\u0647\u200c\u062c\u0648\u06cc\u06cc \u0633\u0627\u0644\u0627\u0646\u0647 \u062d\u062f\u0648\u062f <\/strong><strong>\u06f1\u06f0<\/strong><strong> \u0645\u06cc\u0644\u06cc\u0648\u0646 \u0644\u06cc\u062a\u0631<\/strong> \u0631\u0633\u06cc\u062f\u0647\u200c\u0627\u06cc\u0645.<\/li><\/ul><ol start=\"3\"><li><strong>\u0627\u0646\u0631\u0698\u06cc \u067e\u0627\u06a9 \u0648 \u0645\u0642\u0631\u0648\u0646\u200c\u0628\u0647\u200c\u0635\u0631\u0641\u0647<\/strong><strong> (SDG 7)<\/strong><\/li><\/ol><ul><li>\u0628\u0627 \u062d\u0630\u0641 \u0646\u06cc\u0627\u0632 \u0628\u0647 \u0634\u0633\u062a\u200c\u0648\u0634\u0648\u060c \u0627\u0633\u062a\u0631\u06cc\u0644\u200c\u0633\u0627\u0632\u06cc \u0648 \u062e\u0634\u06a9\u200c\u06a9\u0631\u062f\u0646 \u0645\u062e\u0627\u0632\u0646 \u0633\u0646\u062a\u06cc\u060c \u0645\u0635\u0631\u0641 \u0627\u0646\u0631\u0698\u06cc \u0627\u0644\u06a9\u062a\u0631\u06cc\u06a9\u06cc\u060c \u0628\u062e\u0627\u0631 \u0648 \u0645\u0648\u0627\u062f \u0636\u062f\u0639\u0641\u0648\u0646\u06cc\u200c\u06a9\u0646\u0646\u062f\u0647 \u0628\u0647\u200c\u0637\u0648\u0631 \u0686\u0634\u0645\u06af\u06cc\u0631\u06cc \u06a9\u0627\u0647\u0634 \u06cc\u0627\u0641\u062a\u0647 \u0627\u0633\u062a.<\/li><li>\u0627\u06cc\u0646 \u0627\u0642\u062f\u0627\u0645 \u0645\u0646\u062c\u0631 \u0628\u0647 <strong>\u06a9\u0627\u0647\u0634 \u0631\u062f\u067e\u0627\u06cc \u06a9\u0631\u0628\u0646\u06cc<\/strong> \u0648 \u0645\u0635\u0631\u0641 \u0627\u0646\u0631\u0698\u06cc \u063a\u06cc\u0631\u062a\u062c\u062f\u06cc\u062f\u067e\u0630\u06cc\u0631 \u062f\u0631 \u0628\u06cc\u0645\u0627\u0631\u0633\u062a\u0627\u0646\u200c\u0647\u0627 \u0645\u06cc\u200c\u0634\u0648\u062f.<\/li><\/ul><ol start=\"4\"><li><strong>\u06a9\u0627\u0631 \u0634\u0627\u06cc\u0633\u062a\u0647 \u0648 \u0631\u0634\u062f \u0627\u0642\u062a\u0635\u0627\u062f\u06cc<\/strong><strong> (SDG 8)<\/strong><\/li><\/ol><ul><li>\u0627\u06cc\u062c\u0627\u062f <strong>\u0641\u0631\u0635\u062a\u200c\u0647\u0627\u06cc \u0634\u063a\u0644\u06cc \u067e\u0627\u06cc\u062f\u0627\u0631<\/strong> \u062f\u0631 \u062d\u0648\u0632\u0647 \u062a\u0648\u0644\u06cc\u062f\u060c \u06a9\u0646\u062a\u0631\u0644 \u06a9\u06cc\u0641\u06cc\u062a \u0648 \u0635\u0627\u062f\u0631\u0627\u062a \u0645\u062d\u0635\u0648\u0644\u0627\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646.<\/li><li>\u062a\u0648\u0633\u0639\u0647 \u0638\u0631\u0641\u06cc\u062a \u062a\u0648\u0644\u06cc\u062f \u062a\u0627 <strong>\u062d\u062f\u0648\u062f \u062f\u0648 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u0639\u062f\u062f \u06a9\u06cc\u0633\u0647 \u0633\u0627\u06a9\u0634\u0646 \u062f\u0631 \u0633\u0627\u0644 <\/strong><strong>\u06f1\u06f4\u06f0\u06f2<\/strong>.<\/li><li>\u062a\u0642\u0648\u06cc\u062a \u062a\u0648\u0627\u0646 \u062f\u0627\u062e\u0644\u06cc \u062f\u0631 \u062a\u0648\u0644\u06cc\u062f \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u067e\u0632\u0634\u06a9\u06cc \u0648 <strong>\u06a9\u0627\u0647\u0634 \u0648\u0627\u0628\u0633\u062a\u06af\u06cc \u0628\u0647 \u0648\u0627\u0631\u062f\u0627\u062a<\/strong>.<\/li><\/ul><ol start=\"5\"><li><strong>\u0635\u0646\u0639\u062a\u060c \u0646\u0648\u0622\u0648\u0631\u06cc \u0648 \u0632\u06cc\u0631\u0633\u0627\u062e\u062a<\/strong><strong> (SDG 9)<\/strong><\/li><\/ol><ul><li>\u0628\u0648\u0645\u06cc\u200c\u0633\u0627\u0632\u06cc \u0641\u0646\u0627\u0648\u0631\u06cc \u062a\u0648\u0644\u06cc\u062f \u06a9\u06cc\u0633\u0647 \u0633\u0627\u06a9\u0634\u0646 \u0648 \u062a\u0648\u0633\u0639\u0647 \u0632\u06cc\u0631\u0633\u0627\u062e\u062a\u200c\u0647\u0627\u06cc \u062a\u0648\u0644\u06cc\u062f\u06cc \u062f\u0631 \u062f\u0627\u062e\u0644 \u06a9\u0634\u0648\u0631.<\/li><li>\u06af\u0633\u062a\u0631\u0634 \u0635\u0627\u062f\u0631\u0627\u062a \u0628\u0647 \u06a9\u0634\u0648\u0631\u0647\u0627\u06cc \u0645\u0646\u0637\u0642\u0647 \u0634\u0627\u0645\u0644 <strong>\u0639\u0645\u0627\u0646\u060c \u0639\u0631\u0627\u0642<\/strong> \u0648 \u0628\u0631\u0646\u0627\u0645\u0647\u200c\u0631\u06cc\u0632\u06cc \u0628\u0631\u0627\u06cc \u062d\u0636\u0648\u0631 \u062f\u0631 <strong>\u0628\u0627\u0632\u0627\u0631 \u0622\u0633\u06cc\u0627\u06cc \u0645\u0631\u06a9\u0632\u06cc<\/strong>.<\/li><\/ul><ol start=\"6\"><li><strong>\u0645\u0635\u0631\u0641 \u0648 \u062a\u0648\u0644\u06cc\u062f \u0645\u0633\u0626\u0648\u0644\u0627\u0646\u0647<\/strong><strong> (SDG 12)<\/strong><\/li><\/ol><ul><li>\u062c\u0627\u06cc\u06af\u0632\u06cc\u0646\u06cc \u0641\u0631\u0622\u06cc\u0646\u062f\u0647\u0627\u06cc \u067e\u0631\u0645\u0635\u0631\u0641 \u0628\u0627 \u0631\u0627\u0647\u200c\u062d\u0644\u200c\u0647\u0627\u06cc \u0627\u06cc\u0645\u0646\u200c\u062a\u0631 \u0648 \u06a9\u0627\u0631\u0622\u0645\u062f\u062a\u0631.<\/li><li>\u0627\u062c\u0631\u0627\u06cc \u067e\u0631\u0648\u0698\u0647\u200c\u06cc<strong> \u0628\u062f\u0648\u0646 \u06a9\u0627\u062a\u0627\u0644\u0648\u06af \u06a9\u0627\u063a\u0630\u06cc <\/strong>\u0627\u0632 \u0646\u0645\u0627\u06cc\u0634\u06af\u0627\u0647\u200c\u0647\u0627\u06cc <em>\u0627\u06cc\u0631\u0627\u0646 \u0647\u0644\u062b 1401 <\/em><br \/>\u062f\u0631 \u0627\u06cc\u0646 \u0627\u0642\u062f\u0627\u0645\u060c \u062a\u0645\u0627\u0645 \u0645\u062d\u062a\u0648\u0627\u06cc \u0686\u0627\u067e\u06cc \u062d\u0630\u0641 \u0648 \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u06a9\u0627\u062a\u0627\u0644\u0648\u06af \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644 \u0628\u0627 QR Code \u0627\u0631\u0627\u0626\u0647 \u0634\u062f.<br \/>\u0628\u0627\u0632\u062f\u06cc\u062f\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u0628\u0627 \u0627\u0645\u0636\u0627\u06cc \u00ab\u062f\u06cc\u0648\u0627\u0631 \u062a\u0639\u0647\u062f \u0628\u062f\u0648\u0646 \u06a9\u0627\u063a\u0630\u00bb\u060c \u062d\u0645\u0627\u06cc\u062a \u062e\u0648\u062f \u0631\u0627 \u0627\u0632 \u0627\u06cc\u0646 \u062d\u0631\u06a9\u062a \u0627\u0639\u0644\u0627\u0645 \u06a9\u0631\u062f\u0646\u062f. \u0648 \u062f\u0631 \u0622\u0628\u0627\u062f\u06cc\u0633 \u06a9\u0627\u062a\u0627\u0644\u0648\u06af\u06cc \u0627\u0632 \u0633\u0627\u0644 1401 \u0686\u0627\u067e \u0646\u0634\u062f\u0647 \u0627\u0633\u062a.<\/li><\/ul><ol start=\"7\"><li><strong>\u0627\u0642\u062f\u0627\u0645 \u0628\u0631\u0627\u06cc \u0627\u0642\u0644\u06cc\u0645<\/strong><strong> (SDG 13)<\/strong><\/li><\/ol><ul><li>\u0627\u062c\u0631\u0627\u06cc \u067e\u0631\u0648\u0698\u0647\u200c\u0647\u0627\u06cc <strong>\u0645\u0633\u0626\u0648\u0644\u06cc\u062a \u0627\u062c\u062a\u0645\u0627\u0639\u06cc \u0634\u0631\u06a9\u062a<\/strong><strong> (CSR)<\/strong> \u0627\u0632 \u062c\u0645\u0644\u0647 \u0637\u0631\u062d <strong>\u062f\u0631\u062e\u062a\u06a9\u0627\u0631\u06cc \u0632\u0627\u06af\u0631\u0633 \u0633\u0628\u0632<\/strong> \u0628\u0627 \u0647\u062f\u0641 \u0627\u062d\u06cc\u0627\u06cc \u0645\u0646\u0627\u0637\u0642 \u062c\u0646\u06af\u0644\u06cc \u0622\u0633\u06cc\u0628\u200c\u062f\u06cc\u062f\u0647.<\/li><li>\u0647\u062f\u0641\u200c\u06af\u0630\u0627\u0631\u06cc \u0628\u0631\u0627\u06cc <strong>\u06a9\u0627\u0634\u062a \u0633\u0627\u0644\u0627\u0646\u0647 \u062d\u062f\u0627\u0642\u0644 <\/strong><strong>\u06f1\u06f0\u06f0\u06f0<\/strong><strong> \u0627\u0635\u0644\u0647 \u062f\u0631\u062e\u062a<\/strong> \u062f\u0631 \u0645\u0646\u0627\u0637\u0642 \u063a\u0631\u0628\u06cc \u06a9\u0634\u0648\u0631 \u062a\u0627 \u0633\u0627\u0644 \u06f1\u06f4\u06f0\u06f6.<\/li><\/ul><p>\u00a0<\/p><p style=\"text-align: center;\"><strong>\u062a\u0627\u0631\u06cc\u062e \u062a\u0646\u0638\u06cc\u0645 \u0633\u0646\u062f: \u0627\u0633\u0641\u0646\u062f \u06f1\u06f4\u06f01<\/strong><\/p>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-d01fc56 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"d01fc56\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-f561614\" data-id=\"f561614\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-e845cb9 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"e845cb9\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-f277bfd\" data-id=\"f277bfd\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-307df05 elementor-widget elementor-widget-heading\" data-id=\"307df05\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">\u0627\u0642\u062f\u0627\u0645\u0627\u062a \u0627\u0646\u062c\u0627\u0645\u200c\u0634\u062f\u0647 \u062a\u0627 \u067e\u0627\u06cc\u0627\u0646 \u0633\u0627\u0644 \u06f1\u06f4\u06f0\u06f2<\/h2>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-af71a2d\" data-id=\"af71a2d\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-e23424f elementor-widget-divider--view-line elementor-widget elementor-widget-divider\" data-id=\"e23424f\" data-element_type=\"widget\" data-widget_type=\"divider.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-divider\">\n\t\t\t<span class=\"elementor-divider-separator\">\n\t\t\t\t\t\t<\/span>\n\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-1947153 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"1947153\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-inner-column elementor-element elementor-element-fda89df\" data-id=\"fda89df\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-30aaafa elementor-widget elementor-widget-text-editor\" data-id=\"30aaafa\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<ul><li>\u062a\u0648\u0644\u06cc\u062f \u062d\u062f\u0648\u062f <strong>\u06f2<\/strong> <strong>\u0645\u06cc\u0644\u06cc\u0648\u0646 \u0639\u062f\u062f \u06a9\u06cc\u0633\u0647 \u0633\u0627\u06a9\u0634\u0646 \u06cc\u06a9\u0628\u0627\u0631 \u0645\u0635\u0631\u0641<\/strong> \u062f\u0631 \u0633\u0627\u0644 \u0628\u0631\u0627\u06cc \u0628\u06cc\u0645\u0627\u0631\u0633\u062a\u0627\u0646\u200c\u0647\u0627\u06cc \u0633\u0631\u0627\u0633\u0631 \u06a9\u0634\u0648\u0631.<\/li><li>\u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 \u0648\u0631\u0648\u062f \u0633\u0627\u0644\u0627\u0646\u0647 \u0647\u0632\u0627\u0631\u0627\u0646 \u0644\u06cc\u062a\u0631 \u0645\u0627\u06cc\u0639\u0627\u062a \u0639\u0641\u0648\u0646\u06cc \u0628\u0647 \u0633\u06cc\u0633\u062a\u0645 \u0641\u0627\u0636\u0644\u0627\u0628 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0637\u0631\u0627\u062d\u06cc \u0627\u06cc\u0645\u0646\u200c\u062a\u0631.<\/li><li>\u062f\u0633\u062a\u06cc\u0627\u0628\u06cc \u0628\u0647 <strong>\u0635\u0631\u0641\u0647\u200c\u062c\u0648\u06cc\u06cc \u06a9\u0644 <\/strong><strong>\u06f22<\/strong><strong> \u0645\u06cc\u0644\u06cc\u0648\u0646 \u0644\u06cc\u062a\u0631 \u0622\u0628<\/strong> \u062a\u0627 \u067e\u0627\u06cc\u0627\u0646 \u0633\u0627\u0644 \u06f1\u06f4\u06f0\u06f2 \u0648 \u062a\u062f\u0627\u0648\u0645 \u0631\u0634\u062f \u0622\u0646 \u0628\u0627 \u0646\u0631\u062e \u0633\u0627\u0644\u0627\u0646\u0647 \u06f1\u06f0 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u0644\u06cc\u062a\u0631.<\/li><li>\u0634\u0631\u0648\u0639 \u067e\u0631\u0648\u0698\u0647 \u06a9\u0627\u0634\u062a \u0646\u0647\u0627\u0644 \u062f\u0631 \u0632\u0627\u06af\u0631\u0633<\/li><li>\u0627\u06cc\u062c\u0627\u062f \u0628\u06cc\u0634 \u0627\u0632 <strong>\u06f5\u06f0<\/strong> <strong>\u0634\u063a\u0644 \u0645\u0633\u062a\u0642\u06cc\u0645 \u062a\u062e\u0635\u0635\u06cc<\/strong> \u062f\u0631 \u0628\u062e\u0634\u200c\u0647\u0627\u06cc \u062a\u0648\u0644\u06cc\u062f\u060c \u06a9\u0646\u062a\u0631\u0644 \u06a9\u06cc\u0641\u06cc \u0648 \u062a\u062d\u0642\u06cc\u0642 \u0648 \u062a\u0648\u0633\u0639\u0647.<\/li><li>\u062d\u0636\u0648\u0631 \u0641\u0639\u0627\u0644 \u062f\u0631 \u067e\u0631\u0648\u0698\u0647\u200c\u0647\u0627\u06cc \u067e\u0698\u0648\u0647\u0634\u06cc \u0628\u0627 \u0645\u062d\u0648\u0631\u06cc\u062a \u062a\u0648\u0633\u0639\u0647 \u067e\u0627\u06cc\u062f\u0627\u0631 \u0648 <strong>\u0647\u0648\u0634 \u062a\u062c\u0627\u0631\u06cc<\/strong><strong> (BI)<\/strong> \u0628\u0631\u0627\u06cc \u0627\u0646\u062f\u0627\u0632\u0647\u200c\u06af\u06cc\u0631\u06cc \u062a\u0623\u062b\u06cc\u0631 \u0648\u0627\u0642\u0639\u06cc \u062f\u0631 \u0635\u0631\u0641\u0647\u200c\u062c\u0648\u06cc\u06cc \u0645\u0646\u0627\u0628\u0639.<\/li><li>\u0647\u0645\u06a9\u0627\u0631\u06cc \u0628\u0627 \u0634\u0631\u06a9\u062a <strong>\u0648\u06cc\u0631\u0627\u06a9\u0627\u0645<\/strong> \u0628\u0631\u0627\u06cc \u062a\u062d\u0644\u06cc\u0644 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u067e\u0627\u06cc\u062f\u0627\u0631\u06cc \u062f\u0631 \u0642\u0627\u0644\u0628 <strong>\u062f\u0627\u0634\u0628\u0648\u0631\u062f<\/strong><strong> BI <\/strong><strong>\u0645\u062d\u06cc\u0637 \u0632\u06cc\u0633\u062a\u06cc<\/strong>.<\/li><\/ul>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-9e8ec30 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"9e8ec30\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-c4eceae\" data-id=\"c4eceae\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-ad24f1e elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"ad24f1e\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-157eb0f\" data-id=\"157eb0f\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-c10caef elementor-widget elementor-widget-heading\" data-id=\"c10caef\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">\u062a\u0639\u0647\u062f \u0622\u06cc\u0646\u062f\u0647 (\u0627\u0632 \u0633\u0627\u0644 \u06f1\u06f4\u06f0\u06f3 \u0628\u0647 \u0628\u0639\u062f)<\/h2>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-179c0d8\" data-id=\"179c0d8\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-28f98df elementor-widget-divider--view-line elementor-widget elementor-widget-divider\" data-id=\"28f98df\" data-element_type=\"widget\" data-widget_type=\"divider.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-divider\">\n\t\t\t<span class=\"elementor-divider-separator\">\n\t\t\t\t\t\t<\/span>\n\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-5e0ae2c elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"5e0ae2c\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-inner-column elementor-element elementor-element-14d064c\" data-id=\"14d064c\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-a4e739d elementor-widget elementor-widget-text-editor\" data-id=\"a4e739d\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<p>\u0634\u0631\u06a9\u062a \u0622\u0628\u0627\u062f\u06cc\u0633 \u0645\u062a\u0639\u0647\u062f \u0627\u0633\u062a \u0645\u0633\u06cc\u0631 \u0646\u0648\u0622\u0648\u0631\u06cc \u067e\u0627\u06cc\u062f\u0627\u0631 \u0631\u0627 \u0628\u0627 \u0642\u062f\u0631\u062a \u0627\u062f\u0627\u0645\u0647 \u062f\u0647\u062f \u0627\u0632 \u0637\u0631\u06cc\u0642:<\/p><ul><li>\u06af\u0633\u062a\u0631\u0634 <strong>\u0635\u0627\u062f\u0631\u0627\u062a \u0633\u0628\u0632<\/strong> \u0628\u0647 \u06a9\u0634\u0648\u0631\u0647\u0627\u06cc \u0645\u0646\u0637\u0642\u0647.<\/li><li>\u0627\u06cc\u062c\u0627\u062f <strong>\u0632\u06cc\u0631\u0633\u0627\u062e\u062a \u0622\u0645\u0648\u0632\u0634\u06cc<\/strong> \u0628\u0631\u0627\u06cc \u0628\u06cc\u0645\u0627\u0631\u0633\u062a\u0627\u0646\u200c\u0647\u0627 \u062f\u0631 \u0632\u0645\u06cc\u0646\u0647 \u0645\u0635\u0631\u0641 \u0628\u0647\u06cc\u0646\u0647 \u0645\u0646\u0627\u0628\u0639.<\/li><li>\u06af\u0633\u062a\u0631\u0634 \u067e\u0631\u0648\u0698\u0647\u200c\u06cc <strong>\u0632\u0627\u06af\u0631\u0633 \u0633\u0628\u0632<\/strong> \u0628\u0647 \u0633\u0627\u06cc\u0631 \u0627\u0633\u062a\u0627\u0646\u200c\u0647\u0627.<\/li><li>\u00a0\u0627\u0646\u062a\u0634\u0627\u0631 <strong>\u06af\u0632\u0627\u0631\u0634 \u0633\u0627\u0644\u0627\u0646\u0647 \u067e\u0627\u06cc\u062f\u0627\u0631\u06cc<\/strong><strong> (Abadis Sustainability Report)<\/strong> \u0627\u0632 \u0633\u0627\u0644 <strong>\u06f1\u06f4\u06f0\u06f3<\/strong> \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u0645\u0646\u0638\u0645 \u0648 \u0645\u0633\u062a\u0646\u062f.<\/li><\/ul>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-9c0047a elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"9c0047a\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-d0ee340\" data-id=\"d0ee340\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-66365e5 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"66365e5\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-f1122a8\" data-id=\"f1122a8\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-0319f72 elementor-widget elementor-widget-heading\" data-id=\"0319f72\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">\u06af\u0632\u0627\u0631\u0634\u0627\u062a<\/h2>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-7359e10\" data-id=\"7359e10\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-56859a4 elementor-widget-divider--view-line elementor-widget elementor-widget-divider\" data-id=\"56859a4\" data-element_type=\"widget\" data-widget_type=\"divider.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-divider\">\n\t\t\t<span class=\"elementor-divider-separator\">\n\t\t\t\t\t\t<\/span>\n\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-31f7062 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"31f7062\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-inner-column elementor-element elementor-element-10c320e\" data-id=\"10c320e\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-7135a4a elementor-widget elementor-widget-text-editor\" data-id=\"7135a4a\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<p><strong>\u0628\u0631\u0627\u06cc \u0645\u0634\u0627\u0647\u062f\u0647 \u0627\u0648\u0644\u06cc\u0646 \u06af\u0632\u0627\u0631\u0634 \u062a\u0648\u0633\u0639\u0647 \u067e\u0627\u06cc\u062f\u0627\u0631 \u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634 \u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633 \u062a\u0627 \u067e\u0627\u06cc\u0627\u0646 \u0633\u0627\u0644 1403 \u0631\u0648\u06cc \u0627\u06cc\u0646 <a href=\"https:\/\/abadis-med.com\/%d8%a7%d9%87%d8%af%d8%a7%d9%81-%d8%aa%d9%88%d8%b3%d8%b9%d9%87-%d9%be%d8%a7%db%8c%d8%af%d8%a7%d8%b1-%d8%a2%d8%a8%d8%a7%d8%af%db%8c%d8%b3\/\">\u0644\u06cc\u0646\u06a9<\/a> \u06a9\u0644\u06cc\u06a9 \u0646\u0645\u0627\u06cc\u06cc\u062f.<\/strong><\/p>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>\u0633\u0646\u062f \u062a\u0639\u0647\u062f \u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633 \u0628\u0647 \u0627\u0647\u062f\u0627\u0641 \u062a\u0648\u0633\u0639\u0647 \u067e\u0627\u06cc\u062f\u0627\u0631 \u0633\u0627\u0632\u0645\u0627\u0646 \u0645\u0644\u0644 (UN SDGs) \u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633\u060c \u0628\u0647\u200c\u0639\u0646\u0648\u0627\u0646 \u067e\u06cc\u0634\u0631\u0648 \u062f\u0631 \u062a\u0648\u0644\u06cc\u062f \u06a9\u06cc\u0633\u0647\u200c\u0647\u0627\u06cc \u0633\u0627\u06a9\u0634\u0646 \u06cc\u06a9\u200c\u0628\u0627\u0631\u0645\u0635\u0631\u0641 \u062f