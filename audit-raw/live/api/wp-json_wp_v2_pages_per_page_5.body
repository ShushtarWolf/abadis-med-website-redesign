section-height-default\" data-id=\"f4f26b6\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-9136549\" data-id=\"9136549\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-0787eec dce_masking-none elementor-widget elementor-widget-image\" data-id=\"0787eec\" data-element_type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"1000\" height=\"1000\" src=\"https:\/\/abadis-med.com\/wp-content\/uploads\/2025\/11\/fingertip-1.jpeg\" class=\"attachment-full size-full wp-image-18361\" alt=\"\" srcset=\"https:\/\/abadis-med.com\/wp-content\/uploads\/2025\/11\/fingertip-1.jpeg 1000w, https:\/\/abadis-med.com\/wp-content\/uploads\/2025\/11\/fingertip-1-300x300.jpeg 300w, https:\/\/abadis-med.com\/wp-content\/uploads\/2025\/11\/fingertip-1-150x150.jpeg 150w, https:\/\/abadis-med.com\/wp-content\/uploads\/2025\/11\/fingertip-1-768x768.jpeg 768w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-a0ebaa6\" data-id=\"a0ebaa6\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-b0afee0 elementor-widget elementor-widget-text-editor\" data-id=\"b0afee0\" data-element_type=\"widget\" id=\"Fingertip\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<h1>\u0641\u06cc\u0646\u06af\u0631 \u062a\u06cc\u067e<\/h1><p>\u0641\u06cc\u0646\u06af\u0631\u062a\u06cc\u067e (\u0631\u0627\u0628\u0637 \u0633\u0627\u06a9\u0634\u0646) \u06cc\u06a9 \u0642\u0637\u0639\u0647 \u06a9\u0648\u0686\u06a9 \u0648 \u06a9\u0627\u0631\u0628\u0631\u062f\u06cc \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645\u200c\u0647\u0627\u06cc \u0633\u0627\u06a9\u0634\u0646 \u067e\u0632\u0634\u06a9\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0627\u0645\u06a9\u0627\u0646 \u06a9\u0646\u062a\u0631\u0644 \u062f\u0642\u06cc\u0642 \u0645\u06cc\u0632\u0627\u0646 \u0645\u06a9\u0634 \u0631\u0627 \u0628\u0631\u0627\u06cc \u06a9\u0627\u062f\u0631 \u062f\u0631\u0645\u0627\u0646\u06cc \u0641\u0631\u0627\u0647\u0645 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u0627\u06cc\u0646 \u0645\u062d\u0635\u0648\u0644 \u0628\u06cc\u0646 \u0644\u0648\u0644\u0647 \u0633\u0627\u06a9\u0634\u0646 \u0648 \u0633\u0627\u06cc\u0631 \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u0633\u0627\u06a9\u0634\u0646 \u0645\u0627\u0646\u0646\u062f \u0633\u0648\u0646\u062f \u0646\u0644\u0627\u062a\u0648\u0646 \u0648 \u06a9\u0627\u062a\u062a\u0631 \u0633\u0627\u06a9\u0634\u0646 \u0642\u0631\u0627\u0631 \u06af\u0631\u0641\u062a\u0647 \u0648 \u0639\u0645\u0644\u06a9\u0631\u062f\u06cc \u062f\u0642\u06cc\u0642 \u0648 \u0642\u0627\u0628\u0644 \u062a\u0646\u0638\u06cc\u0645 \u0631\u0627 \u0627\u0631\u0627\u0626\u0647 \u0645\u06cc\u200c\u062f\u0647\u062f.<\/p><p>\u0627\u06cc\u0646 \u0645\u062d\u0635\u0648\u0644 \u062f\u0631 \u062c\u0631\u0627\u062d\u06cc\u200c\u0647\u0627\u06cc \u0639\u0645\u0648\u0645\u06cc\u060c \u067e\u0644\u0627\u0633\u062a\u06cc\u06a9\u060c \u0645\u063a\u0632 \u0648 \u0627\u0639\u0635\u0627\u0628 \u0648 \u062f\u0646\u062f\u0627\u0646\u067e\u0632\u0634\u06a9\u06cc \u0645\u0648\u0631\u062f \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0642\u0631\u0627\u0631 \u0645\u06cc\u200c\u06af\u06cc\u0631\u062f \u0648 \u0628\u0647 \u0628\u0647\u0628\u0648\u062f \u0639\u0645\u0644\u06a9\u0631\u062f \u0633\u0627\u06a9\u0634\u0646 \u0648 \u06a9\u0627\u0647\u0634 \u0622\u0633\u06cc\u0628 \u0628\u0647 \u0628\u0627\u0641\u062a\u200c\u0647\u0627\u06cc \u062d\u0633\u0627\u0633 \u06a9\u0645\u06a9 \u0645\u06cc\u200c\u06a9\u0646\u062f.<\/p><h2><strong data-start=\"340\" data-end=\"361\">\u0648\u06cc\u0698\u06af\u06cc\u200c\u0647\u0627 \u0648 \u0645\u0632\u0627\u06cc\u0627:<\/strong><\/h2><ul><li><strong>\u06a9\u0646\u062a\u0631\u0644 \u0628\u0647\u06cc\u0646\u0647 \u0645\u06a9\u0634<\/strong> \u062a\u0646\u0647\u0627 \u0628\u0627 \u0642\u0631\u0627\u0631 \u062f\u0627\u062f\u0646 \u06cc\u0627 \u0628\u0631\u062f\u0627\u0634\u062a\u0646 \u0627\u0646\u06af\u0634\u062a \u0631\u0648\u06cc \u062f\u0631\u06cc\u0686\u0647 \u0645\u062e\u0635\u0648\u0635<\/li><li><strong>\u0637\u0631\u0627\u062d\u06cc \u0627\u0631\u06af\u0648\u0646\u0648\u0645\u06cc\u06a9<\/strong> \u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0637\u0648\u0644\u0627\u0646\u06cc\u200c\u0645\u062f\u062a<\/li><li><strong>\u06a9\u0627\u0647\u0634 \u062e\u0637\u0631<\/strong> \u0622\u0633\u06cc\u0628 \u0628\u0647 \u0628\u0627\u0641\u062a\u200c\u0647\u0627\u06cc \u0646\u0631\u0645 \u062f\u0631 \u062d\u06cc\u0646 \u0633\u0627\u06a9\u0634\u0646<\/li><li><strong>\u0642\u0627\u0628\u0644 \u0627\u0633\u062a\u0641\u0627\u062f\u0647<\/strong> \u0628\u0627 \u0627\u0646\u0648\u0627\u0639 \u0644\u0648\u0644\u0647\u200c\u0647\u0627\u06cc \u0633\u0627\u06a9\u0634\u0646<\/li><li><strong>\u0627\u062a\u0635\u0627\u0644 \u0627\u06cc\u0645\u0646<\/strong> \u0628\u0647 \u0627\u0646\u0648\u0627\u0639 \u0644\u0648\u0644\u0647\u200c\u0647\u0627\u06cc \u0633\u0627\u06a9\u0634\u0646 \u0648 \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 \u0646\u0634\u062a \u0645\u0627\u06cc\u0639\u0627\u062a<\/li><li><strong>\u06a9\u0627\u0631\u0628\u0631\u06cc \u0622\u0633\u0627\u0646<\/strong> \u0628\u0631\u0627\u06cc \u062a\u0646\u0638\u06cc\u0645 \u0633\u0631\u06cc\u0639 \u0648 \u0645\u0648\u062b\u0631 \u0641\u0634\u0627\u0631 \u0645\u06a9\u0634 \u0628\u062f\u0648\u0646 \u0646\u06cc\u0627\u0632 \u0628\u0647 \u062e\u0627\u0645\u0648\u0634 \u0648 \u0631\u0648\u0634\u0646 \u06a9\u0631\u062f\u0646 \u062f\u0633\u062a\u06af\u0627\u0647 \u0633\u0627\u06a9\u0634\u0646<\/li><li><p><strong>\u0633\u0627\u062e\u062a\u0627\u0631 \u0645\u062f\u06cc\u06a9\u0627\u0644 \u06af\u0631\u06cc\u062f<\/strong>\u060c \u0642\u0627\u0628\u0644 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u062f\u0631 \u062c\u0631\u0627\u062d\u06cc\u200c\u0647\u0627\u06cc \u0639\u0645\u0648\u0645\u06cc\u060c \u062f\u0646\u062f\u0627\u0646\u067e\u0632\u0634\u06a9\u06cc \u0648 \u0645\u0631\u0627\u0642\u0628\u062a\u200c\u0647\u0627\u06cc \u0648\u06cc\u0698\u0647<\/p><\/li><\/ul><h2 data-start=\"692\" data-end=\"713\"><strong data-start=\"696\" data-end=\"711\">\u062c\u0646\u0633 \u0648 \u0633\u0627\u06cc\u0632:<\/strong><\/h2><p data-start=\"714\" data-end=\"841\" data-is-last-node=\"\" data-is-only-node=\"\">\u0641\u06cc\u0646\u06af\u0631\u062a\u06cc\u067e \u0627\u0632 <strong data-start=\"726\" data-end=\"758\">\u067e\u0644\u06cc\u200c\u0648\u06cc\u0646\u06cc\u0644 \u06a9\u0644\u0631\u0627\u06cc\u062f (PVC) \u067e\u0632\u0634\u06a9\u06cc<\/strong> \u0633\u0627\u062e\u062a\u0647 \u0634\u062f\u0647 \u0648 \u062f\u0631 \u062f\u0648 \u0633\u0627\u06cc\u0632 <strong data-start=\"782\" data-end=\"797\">\u0628\u0632\u0631\u06af \u0648 \u06a9\u0648\u0686\u06a9<\/strong> \u0645\u062a\u0646\u0627\u0633\u0628 \u0628\u0627 \u0627\u0646\u0648\u0627\u0639 \u0644\u0648\u0644\u0647\u200c\u0647\u0627\u06cc \u0633\u0627\u06a9\u0634\u0646 \u0639\u0631\u0636\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f.<\/p>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-9afeb27 ee-table--responsive ee-table-mobile-header--row elementor-widget elementor-widget-table\" data-id=\"9afeb27\" data-element_type=\"widget\" data-settings=\"{&quot;mobile_headers_auto&quot;:&quot;yes&quot;}\" data-widget_type=\"table.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n\t\t<table class=\"ee-table ee-table--even ee-table--rules\">\n\n\t\t\t\t\t\t<colgroup>\n\t\t\t\t\t\t\t\t<col span=\"1\" class=\"elementor-repeater-item-fd63f52\">\n\t\t\t\t\t\t\t<\/colgroup>\n\t\t<thead>\n\t\t\t<tr class=\"ee-table__row\">\n\n\t\t\t<th class=\"ee-table__cell elementor-repeater-item-4800b1f\">\n\t\t\t\t\t<span class=\"ee-table__text\"><span class=\"ee-table__text__inner\">\u06a9\u062f \u06a9\u0627\u0644\u0627<\/span>\n\n\t\t\t\t\t\t\n\t\t\t\t\t<\/span>\n\t\t\t\t<\/th>\n\n\t\t\t<th class=\"ee-table__cell elementor-repeater-item-554534c\">\n\t\t\t\t\t<span class=\"ee-table__text\"><span class=\"ee-table__text__inner\">\u0646\u0627\u0645 \u06a9\u0627\u0644\u0627<\/span>\n\n\t\t\t\t\t\t\n\t\t\t\t\t<\/span>\n\t\t\t\t<\/th>\n\n\t\t\t\t\t\t<\/tr>\n\t\t<\/thead><tbody><tr class=\"ee-table__row elementor-repeater-item-1bbee55\">\n\t\t<td class=\"ee-table__cell elementor-repeater-item-5b07214\" data-title=\"\u06a9\u062f \u06a9\u0627\u0644\u0627\">\n\t\t\t<span class=\"ee-table__text\"><span class=\"ee-table__text__inner\">040602<\/span>\n\n\t\t\t<\/span>\n\t\t<\/td><td class=\"ee-table__cell elementor-repeater-item-c928271\" data-title=\"\u0646\u0627\u0645 \u06a9\u0627\u0644\u0627\">\n\t\t\t<span class=\"ee-table__text\"><span class=\"ee-table__text__inner\">\u0641\u06cc\u0646\u06af\u0631\u062a\u06cc\u067e (\u0631\u0627\u0628\u0637 \u0633\u0627\u06a9\u0634\u0646)<\/span>\n\n\t\t\t<\/span>\n\t\t<\/td><\/tr>\n\t\t\t<\/tbody>\n\t\t<\/table>\n\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>\u0633\u0627\u06a9\u0634\u0646 \u062a\u06cc\u0648\u0628 (\u0644\u0648\u0644\u0647 \u0633\u0627\u06a9\u0634\u0646) \u0633\u0627\u06a9\u0634\u0646 \u062a\u06cc\u0648\u0628 \u0644\u0648\u0644\u0647 \u0633\u0627\u06a9\u0634\u0646 (Suction Tube) \u0641\u06cc\u0646\u06af\u0631 \u062a\u06cc\u067e (\u0631\u0627\u0628\u0637 \u0633\u0627\u06a9\u0634\u0646) \u0633\u0627\u06a9\u0634\u0646 \u062a\u06cc\u0648\u0628 \u0644\u0648\u0644\u0647 \u0633\u0627\u06a9\u0634\u0646 (Suction Tube) \u0622\u0628\u0627\u062f\u06cc\u0633 \u06cc\u06a9\u06cc \u0627\u0632 \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u0636\u0631\u0648\u0631\u06cc \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645\u200c\u0647\u0627\u06cc \u0633\u0627\u06a9\u0634\u0646 \u067e\u0632\u0634\u06a9\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0628\u0631\u0627\u06cc \u062a\u062e\u0644\u06cc\u0647 \u062e\u0648\u0646\u060c \u062a\u0631\u0634\u062d\u0627\u062a \u0648 \u0645\u0627\u06cc\u0639\u0627\u062a \u062f\u0631 \u0637\u0648\u0644 \u0641\u0631\u0622\u06cc\u0646\u062f\u0647\u0627\u06cc \u062c\u0631\u0627\u062d\u06cc \u0648 \u062f\u0631\u0645\u0627\u0646\u06cc \u0645\u0648\u0631\u062f \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0642\u0631\u0627\u0631 \u0645\u06cc\u200c\u06af\u06cc\u0631\u062f. \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u06cc\u0646 \u0644\u0648\u0644\u0647 \u0645\u0648\u062c\u0628 \u0627\u0641\u0632\u0627\u06cc\u0634 \u0648\u0636\u0648\u062d \u062f\u06cc\u062f [&hellip;]<\/p>\n","protected":false},"author":2,"featured_media":0,"parent":9,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"footnotes":""},"class_list":["post-14064","page","type-page","status-publish","hentry"],"acf":[],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v19.5 (Yoast SEO v19.10) - https:\/\/yoast.com\/wordpress\/plugins\/seo\/ -->\n<title>\u0633\u0627\u06a9\u0634\u0646 \u062a\u06cc\u0648\u0628 &raquo; \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/abadis-med.com\/\u0645\u062d\u0635\u0648\u0644\u0627\u062a\/\u0633\u0627\u06a9\u0634\u0646-\u062a\u06cc\u0648\u0628\/\" \/>\n<meta property=\"og:locale\" content=\