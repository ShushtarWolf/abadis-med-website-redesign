67\"><li data-start=\"1756\" data-end=\"1767\"><p data-start=\"1758\" data-end=\"1767\"><strong data-start=\"1758\" data-end=\"1767\">\u06f2 \u0645\u062a\u0631<\/strong><\/p><\/li><\/ul><\/li><li data-start=\"1769\" data-end=\"1905\"><p data-start=\"1771\" data-end=\"1796\"><strong data-start=\"1771\" data-end=\"1794\">\u0642\u0627\u0628\u0644\u06cc\u062a \u0633\u0641\u0627\u0631\u0634\u06cc\u200c\u0633\u0627\u0632\u06cc:<\/strong><\/p><ul data-start=\"1799\" data-end=\"1905\"><li data-start=\"1799\" data-end=\"1857\"><p data-start=\"1801\" data-end=\"1857\">\u0627\u0645\u06a9\u0627\u0646 \u062a\u0648\u0644\u06cc\u062f \u062f\u0631 \u0637\u0648\u0644\u200c\u0647\u0627\u06cc \u0645\u062e\u062a\u0644\u0641 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0646\u06cc\u0627\u0632 \u0645\u0631\u0627\u06a9\u0632 \u062f\u0631\u0645\u0627\u0646\u06cc<\/p><\/li><li data-start=\"1860\" data-end=\"1905\"><p data-start=\"1862\" data-end=\"1905\">\u0645\u0648\u062c\u0648\u062f \u062f\u0631 \u0633\u0627\u06cc\u0632\u0647\u0627\u06cc \u0648\u06cc\u0698\u0647 \u0645\u0637\u0627\u0628\u0642 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0645\u0634\u062a\u0631\u06cc<\/p><\/li><\/ul><\/li><\/ul><h2 data-start=\"1636\" data-end=\"1658\"><strong data-start=\"1639\" data-end=\"1658\">\u0628\u0633\u062a\u0647\u200c\u0628\u0646\u062f\u06cc \u0645\u062d\u0635\u0648\u0644:<\/strong><\/h2><ul data-start=\"1660\" data-end=\"1831\"><li data-start=\"1660\" data-end=\"1695\"><p data-start=\"1662\" data-end=\"1695\">\u0628\u0633\u062a\u0647\u200c\u0628\u0646\u062f\u06cc \u062f\u0631 <strong data-start=\"1675\" data-end=\"1693\">\u062f\u0627\u06cc\u06a9\u0627\u062a \u06f2\u06f5 \u0639\u062f\u062f\u06cc<\/strong><\/p><\/li><li data-start=\"1696\" data-end=\"1730\"><p data-start=\"1698\" data-end=\"1730\"><strong data-start=\"1698\" data-end=\"1728\">\u062a\u0639\u062f\u0627\u062f \u062f\u0631 \u0647\u0631 \u06a9\u0627\u0631\u062a\u0646: \u06f1\u06f0\u06f0 \u0639\u062f\u062f<\/strong><\/p><\/li><li data-start=\"