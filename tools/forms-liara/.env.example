# Copy to the Liara panel for the abadis-forms app. Do not commit real values.
# FORM_TO is the inbox. MAIL_TO is accepted as an alias if FORM_TO is empty.
ALLOWED_ORIGINS=https://abadis-med.com,https://www.abadis-med.com,https://abadis-test.liara.run,https://shushtarwolf.github.io
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
FORM_TO=info@abadis-med.com
# Optional per-form inboxes. Empty falls back to FORM_TO.
FORM_TO_CONTACT=
FORM_TO_CAREERS=
FORM_TO_EXPORT=
RATE_PER_MIN=5
MAX_UPLOAD_MB=8
MAX_FIELD_CHARS=4000
