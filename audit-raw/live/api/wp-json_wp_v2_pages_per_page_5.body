n\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-f45c346\" data-id=\"f45c346\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-efcb829 elementor-widget elementor-widget-heading\" data-id=\"efcb829\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\"><a href=\"#Tube\">\u0644\u0648\u0644\u0647 \u0633\u0627\u06a9\u0634\u0646 (Suction Tube)<\/a><\/h2>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-78398e5\" data-id=\"78398e5\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-a213567 elementor-widget elementor-widget-heading\" data-id=\"a213567\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\"><a href=\"#Fingertip\">\u0641\u06cc\u0646\u06af\u0631 \u062a\u06cc\u067e (\u0631\u0627\u0628\u0637 \u0633\u0627\u06a9\u0634\u0646)<\/a><\/h2>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-b8a1049 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"b8a1049\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-8eb9dbb\" data-id=\"8eb9dbb\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-c6d981b dce_masking-none elementor-widget elementor-widget-image\" data-id=\"c6d981b\" data-element_type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"300\" height=\"300\" src=\"https:\/\/abadis-med.com\/wp-content\/uploads\/2023\/02\/7e83722522e8aeb7512b7075311316b7__m8ULku2SAG__1-1-300x300.jpg\" class=\"attachment-medium size-medium wp-image-14069\" alt=\"\" srcset=\"https:\/\/abadis-med.com\/wp-content\/uploads\/2023\/02\/7e83722522e8aeb7512b7075311316b7__m8ULku2SAG__1-1-300x300.jpg 300w, https:\/\/abadis-med.com\/wp-content\/uploads\/2023\/02\/7e83722522e8aeb7512b7075311316b7__m8ULku2SAG__1-1-1024x1024.jpg 1024w, https:\/\/abadis-med.com\/wp-content\/uploads\/2023\/02\/7e83722522e8aeb7512b7075311316b7__m8ULku2SAG__1-1-150x150.jpg 150w, https:\/\/abadis-med.com\/wp-content\/uploads\/2023\/02\/7e83722522e8aeb7512b7075311316b7__m8ULku2SAG__1-1-768x768.jpg 768w, https:\/\/abadis-med.com\/wp-content\/uploads\/2023\/02\/7e83722522e8aeb7512b7075311316b7__m8ULku2SAG__1-1.jpg 1080w\" sizes=\"auto, (max-width: 300px) 100vw, 300px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-7f687b7\" data-id=\"7f687b7\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-8efaa0a elementor-widget elementor-widget-text-editor\" data-id=\"8efaa0a\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<h1>\u0633\u0627\u06a9\u0634\u0646 \u062a\u06cc\u0648\u0628<\/h1><p>\u0644\u0648\u0644\u0647 \u0633\u0627\u06a9\u0634\u0646 (Suction Tube) \u0622\u0628\u0627\u062f\u06cc\u0633 \u06cc\u06a9\u06cc \u0627\u0632 \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u0636\u0631\u0648\u0631\u06cc \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645\u200c\u0647\u0627\u06cc \u0633\u0627\u06a9\u0634\u0646 \u067e\u0632\u0634\u06a9\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0628\u0631\u0627\u06cc \u062a\u062e\u0644\u06cc\u0647 \u062e\u0648\u0646\u060c \u062a\u0631\u0634\u062d\u0627\u062a \u0648 \u0645\u0627\u06cc\u0639\u0627\u062a \u062f\u0631 \u0637\u0648\u0644 \u0641\u0631\u0622\u06cc\u0646\u062f\u0647\u0627\u06cc \u062c\u0631\u0627\u062d\u06cc \u0648 \u062f\u0631\u0645\u0627\u0646\u06cc \u0645\u0648\u0631\u062f \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0642\u0631\u0627\u0631 \u0645\u06cc\u200c\u06af\u06cc\u0631\u062f. \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u06cc\u0646 \u0644\u0648\u0644\u0647 \u0645\u0648\u062c\u0628 <strong data-start=\"461\" data-end=\"485\">\u0627\u0641\u0632\u0627\u06cc\u0634 \u0648\u0636\u0648\u062d \u062f\u06cc\u062f \u062c\u0631\u0627\u062d<\/strong> \u0634\u062f\u0647 \u0648 \u0628\u0627 \u0647\u062f\u0627\u06cc\u062a \u0633\u0631\u06cc\u0639 \u0645\u0627\u06cc\u0639\u0627\u062a\u060c \u0627\u0632 <strong data-start=\"517\" data-end=\"547\">\u0646\u0641\u0648\u0630 \u0622\u0644\u0648\u062f\u06af\u06cc \u0648 \u0627\u0646\u062a\u0634\u0627\u0631 \u0639\u0641\u0648\u0646\u062a<\/strong> \u0628\u0647 \u0633\u0627\u06cc\u0631 \u0628\u062e\u0634\u200c\u0647\u0627\u06cc \u0628\u062f\u0646 \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f.<\/p><h2 data-start=\"590\" data-end=\"618\"><strong data-start=\"593\" data-end=\"618\">\u0645\u0648\u0627\u0631\u062f \u0645\u0635\u0631\u0641 \u0633\u0627\u06a9\u0634\u0646 \u062a\u06cc\u0648\u0628:<\/strong><\/h2><ul data-start=\"620\" data-end=\"1056\"><li data-start=\"620\" data-end=\"697\"><p data-start=\"622\" data-end=\"697\">\u062a\u0645\u06cc\u0632 \u0646\u06af\u0647\u200c\u062f\u0627\u0634\u062a\u0646 \u0632\u062e\u0645 \u0628\u0631\u0627\u06cc \u0645\u0634\u0627\u0647\u062f\u0647 \u062f\u0642\u06cc\u0642 \u0645\u062d\u0644 \u062e\u0648\u0646\u0631\u06cc\u0632\u06cc \u0648 \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 \u0627\u0646\u062a\u0642\u0627\u0644 \u0639\u0641\u0648\u0646\u062a<\/p><\/li><li data-start=\"698\" data-end=\"732\"><p data-start=\"700\" data-end=\"732\">\u062a\u062e\u0644\u06cc\u0647 \u0648 \u067e\u0627\u06a9\u200c\u0633\u0627\u0632\u06cc \u062d\u0641\u0631\u0647\u200c\u0647\u0627\u06cc \u0622\u0628\u0633\u0647<\/p><\/li><li data-start=\"733\" data-end=\"783\"><p data-start=\"735\" data-end=\"783\">\u06a9\u0627\u0631\u0628\u0631\u062f \u062f\u0631 \u062c\u0631\u0627\u062d\u06cc\u200c\u0647\u0627\u06cc \u0633\u06cc\u0646\u0647\u060c \u0634\u06a9\u0645 \u0648 \u062d\u0641\u0631\u0647\u200c\u0647\u0627\u06cc \u062f\u0627\u062e\u0644\u06cc<\/p><\/li><li data-start=\"784\" data-end=\"843\"><p data-start=\"786\" data-end=\"843\">\u0645\u0646\u0627\u0633\u0628 \u062c\u0647\u062a \u062a\u062e\u0644\u06cc\u0647 \u0628\u0627\u0641\u062a\u200c\u0647\u0627\u06cc \u0622\u0633\u06cc\u0628\u200c\u062f\u06cc\u062f\u0647 \u0645\u063a\u0632\u06cc \u06cc\u0627 \u062a\u0648\u0645\u0648\u0631\u0647\u0627\u06cc \u0646\u0631\u0645<\/p><\/li><li data-start=\"844\" data-end=\"882\"><p data-start=\"846\" data-end=\"882\">\u06a9\u0645\u06a9 \u0628\u0647 \u06a9\u0645\u067e\u0631\u0633 \u06a9\u0631\u062f\u0646 \u0631\u06af \u062e\u0648\u0646\u0631\u06cc\u0632\u06cc\u200c\u06a9\u0646\u0646\u062f\u0647<\/p><\/li><li data-start=\"883\" data-end=\"949\"><p data-start=\"885\" data-end=\"949\">\u0642\u0627\u0628\u0644 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u062f\u0631 \u0639\u0645\u0644\u200c\u0647\u0627\u06cc \u0632\u06cc\u0628\u0627\u06cc\u06cc: \u0644\u06cc\u067e\u0648\u0633\u0627\u06a9\u0634\u0646\u060c \u0644\u06cc\u067e\u0648\u0644\u06cc\u0632\u0631\u060c \u0644\u06cc\u067e\u0648\u0645\u0627\u062a\u06cc\u06a9<\/p><\/li><li data-start=\"950\" data-end=\"987\"><p data-start=\"952\" data-end=\"987\">\u0645\u0646\u0627\u0633\u0628 \u0628\u0631\u0627\u06cc \u06a9\u0644\u06cc\u0646\u06cc\u06a9\u200c\u0647\u0627\u06cc \u062f\u0646\u062f\u0627\u0646\u200c\u067e\u0632\u0634\u06a9\u06cc<\/p><\/li><li data-start=\"988\" data-end=\"1056\"><p data-start=\"990\" data-end=\"1056\">\u0642\u0627\u0628\u0644 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u0641\u06cc\u0646\u06af\u0631\u062a\u06cc\u067e\u060c \u06a9\u0627\u062a\u062a\u0631 \u0633\u0627\u06a9\u0634\u0646 \u0648 \u0633\u0627\u06cc\u0631 \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u0645\u0631\u062a\u0628\u0637<\/p><\/li><\/ul><h2 data-start=\"1063\" data-end=\"1086\"><strong data-start=\"1066\" data-end=\"1086\">\u0648\u06cc\u0698\u06af\u06cc\u200c\u0647\u0627 \u0648 \u0645\u0632\u0627\u06cc\u0627:<\/strong><\/h2><ul data-start=\"1088\" data-end=\"1558\"><li data-start=\"1088\" data-end=\"1146\"><p data-start=\"1090\" data-end=\"1146\"><strong data-start=\"1090\" data-end=\"1122\">\u0633\u0627\u062e\u062a\u0647\u200c\u0634\u062f\u0647 \u0627\u0632 PVC \u0645\u062f\u06cc\u06a9\u0627\u0644\u200c\u06af\u0631\u06cc\u062f<\/strong> \u0628\u0627 \u0628\u0627\u0644\u0627\u062a\u0631\u06cc\u0646 \u0633\u0637\u062d \u0627\u06cc\u0645\u0646\u06cc<\/p><\/li><li data-start=\"1147\" data-end=\"1210\"><p data-start=\"1149\" data-end=\"1210\"><strong data-start=\"1149\" data-end=\"1159\">\u0627\u0633\u062a\u0631\u06cc\u0644<\/strong> \u0648 \u0645\u0646\u0627\u0633\u0628 \u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u062f\u0631 \u0627\u062a\u0627\u0642 \u0639\u0645\u0644 \u0648 \u0628\u062e\u0634\u200c\u0647\u0627\u06cc \u062a\u062e\u0635\u0635\u06cc<\/p><\/li><li data-start=\"1211\" data-end=\"1328\"><p data-start=\"1213\" data-end=\"1232\">\u062f\u0627\u0631\u0627\u06cc <strong data-start=\"1219\" data-end=\"1230\">\u062f\u0648 \u0645\u062f\u0644:<\/strong><\/p><ul data-start=\"1235\" data-end=\"1328\"><li data-start=\"1235\" data-end=\"1276\"><p data-start=\"1237\" data-end=\"1276\"><em data-start=\"1237\" data-end=\"1243\">\u0634\u0641\u0627\u0641<\/em> (\u0628\u0631\u0627\u06cc \u0645\u0634\u0627\u0647\u062f\u0647 \u0645\u0633\u06cc\u0631 \u062d\u0631\u06a9\u062a \u0645\u0627\u06cc\u0639\u0627\u062a)<\/p><\/li><li data-start=\"1279\" data-end=\"1328\"><p data-start=\"1281\" data-end=\"1328\"><em data-start=\"1281\" data-end=\"1291\">\u0634\u06cc\u0627\u0631\u200c\u062f\u0627\u0631<\/em> (\u0628\u0631\u0627\u06cc \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 \u062e\u0645\u200c\u0634\u062f\u06af\u06cc \u0648 \u0627\u0646\u0633\u062f\u0627\u062f)<\/p><\/li><\/ul><\/li><li data-start=\"1329\" data-end=\"1391\"><p data-start=\"1331\" data-end=\"1391\"><strong data-start=\"1331\" data-end=\"1357\">\u0627\u0646\u0639\u0637\u0627\u0641\u200c\u067e\u0630\u06cc\u0631\u06cc \u06a9\u0646\u062a\u0631\u0644\u200c\u0634\u062f\u0647<\/strong> \u0628\u0631\u0627\u06cc \u06a9\u0627\u0647\u0634 \u0622\u0633\u06cc\u0628 \u0628\u0647 \u0628\u0627\u0641\u062a\u200c\u0647\u0627\u06cc \u062d\u0633\u0627\u0633<\/p><\/li><li data-start=\"1392\" data-end=\"1444\"><p data-start=\"1394\" data-end=\"1444\"><strong data-start=\"1394\" data-end=\"1419\">\u0627\u062a\u0635\u0627\u0644 \u0627\u06cc\u0645\u0646 \u0648 \u0628\u062f\u0648\u0646 \u0646\u0634\u062a<\/strong> \u0628\u0647 \u0627\u0646\u0648\u0627\u0639 \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u0633\u0627\u06a9\u0634\u0646<\/p><\/li><li data-start=\"1445\" data-end=\"1495\"><p data-start=\"1447\" data-end=\"1495\">\u0633\u0627\u0632\u06af\u0627\u0631 \u0628\u0627 \u0633\u06cc\u0633\u062a\u0645\u200c\u0647\u0627\u06cc \u0633\u0627\u06a9\u0634\u0646 \u0628\u06cc\u0645\u0627\u0631\u0633\u062a\u0627\u0646\u06cc \u0648 \u06a9\u0644\u06cc\u0646\u06cc\u06a9\u06cc<\/p><