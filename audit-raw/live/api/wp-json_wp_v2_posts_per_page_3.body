[{"id":19271,"date":"2026-09-23T10:24:54","date_gmt":"2026-09-23T10:24:54","guid":{"rendered":"https:\/\/abadis-med.com\/?p=19271"},"modified":"2026-09-23T10:24:54","modified_gmt":"2026-09-23T10:24:54","slug":"%d8%a7%d8%b3%d8%aa%d8%ae%d8%af%d8%a7%d9%85-%da%a9%d8%a7%d8%b1%d8%b4%d9%86%d8%a7%d8%b3-%d9%81%d8%b1%d9%88%d8%b4-%d8%af%d8%b1-%d8%b4%d8%b1%da%a9%d8%aa-%d8%af%d8%a7%d9%86%d8%b4%d8%a8%d9%86%db%8c","status":"publish","type":"post","link":"https:\/\/abadis-med.com\/%d8%a7%d8%b3%d8%aa%d8%ae%d8%af%d8%a7%d9%85-%da%a9%d8%a7%d8%b1%d8%b4%d9%86%d8%a7%d8%b3-%d9%81%d8%b1%d9%88%d8%b4-%d8%af%d8%b1-%d8%b4%d8%b1%da%a9%d8%aa-%d8%af%d8%a7%d9%86%d8%b4%d8%a8%d9%86%db%8c\/","title":{"rendered":"\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u06a9\u0627\u0631\u0634\u0646\u0627\u0633 \u0641\u0631\u0648\u0634 \u062f\u0631 \u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633"},"content":{"rendered":"<p data-pm-slice=\"1 1 []\">\u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633 \u0628\u0631\u0627\u06cc \u062a\u06a9\u0645\u06cc\u0644 \u062a\u06cc\u0645 \u0641\u0631\u0648\u0634 \u062e\u0648\u062f \u0627\u0632 \u0639\u0644\u0627\u0642\u0647\u200c\u0645\u0646\u062f\u0627\u0646 \u0628\u0647 \u0641\u0639\u0627\u0644\u06cc\u062a \u062f\u0631 \u062d\u0648\u0632\u0647 \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u067e\u0632\u0634\u06a9\u06cc \u062f\u0639\u0648\u062a \u0628\u0647 \u0647\u0645\u06a9\u0627\u0631\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f.<\/p>\n<p>\u0627\u06af\u0631 \u062f\u0631 \u0628\u0631\u0642\u0631\u0627\u0631\u06cc \u0627\u0631\u062a\u0628\u0627\u0637 \u0628\u0627 \u0645\u0634\u062a\u0631\u06cc\u0627\u0646 \u0648 \u067e\u06cc\u06af\u06cc\u0631\u06cc \u0627\u0645\u0648\u0631 \u0641\u0631\u0648\u0634 \u062a\u0648\u0627\u0646\u0645\u0646\u062f \u0647\u0633\u062a\u06cc\u062f\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0634\u0631\u062d \u0648\u0638\u0627\u06cc\u0641\u060c \u0634\u0631\u0627\u06cc\u0637 \u0647\u0645\u06a9\u0627\u0631\u06cc \u0648 \u0631\u0648\u0634 \u0627\u0631\u0633\u0627\u0644 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0631\u0627 \u062f\u0631 \u0622\u06af\u0647\u06cc \u0627\u06cc\u0646 \u0645\u0648\u0642\u0639\u06cc\u062a \u0634\u063a\u0644\u06cc \u0645\u0634\u0627\u0647\u062f\u0647 \u06a9\u0646\u06cc\u062f.<\/p>\n<p><strong><a href=\"https:\/\/abadis-med.com\/_joboffers\/%da%a9%d8%a7%d8%b1%d8%b4%d9%86%d8%a7%d8%b3-%d9%81%d8%b1%d9%88%d8%b4\/\">\u0645\u0634\u0627\u0647\u062f\u0647 \u0645\u0648\u0642\u0639\u06cc\u062a \u0634\u063a\u0644\u06cc \u06a9\u0627\u0631\u0634\u0646\u0627\u0633 \u0641\u0631\u0648\u0634 \u0648 \u0627\u0631\u0633\u0627\u0644 \u062f\u0631\u062e\u0648\u0627\u0633\u062a<\/a><\/strong><\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp;<\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633 \u0628\u0631\u0627\u06cc \u062a\u06a9\u0645\u06cc\u0644 \u062a\u06cc\u0645 \u0641\u0631\u0648\u0634 \u062e\u0648\u062f \u0627\u0632 \u0639\u0644\u0627\u0642\u0647\u200c\u0645\u0646\u062f\u0627\u0646 \u0628\u0647 \u0641\u0639\u0627\u0644\u06cc\u062a \u062f\u0631 \u062d\u0648\u0632\u0647 \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u067e\u0632\u0634\u06a9\u06cc \u062f\u0639\u0648\u062a \u0628\u0647 \u0647\u0645\u06a9\u0627\u0631\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f. \u0627\u06af\u0631 \u062f\u0631 \u0628\u0631\u0642\u0631\u0627\u0631\u06cc \u0627\u0631\u062a\u0628\u0627\u0637 \u0628\u0627 \u0645\u0634\u062a\u0631\u06cc\u0627\u0646 \u0648 \u067e\u06cc\u06af\u06cc\u0631\u06cc \u0627\u0645\u0648\u0631 \u0641\u0631\u0648\u0634 \u062a\u0648\u0627\u0646\u0645\u0646\u062f \u0647\u0633\u062a\u06cc\u062f\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0634\u0631\u062d \u0648\u0638\u0627\u06cc\u0641\u060c \u0634\u0631\u0627\u06cc\u0637 \u0647\u0645\u06a9\u0627\u0631\u06cc \u0648 \u0631\u0648\u0634 \u0627\u0631\u0633\u0627\u0644 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0631\u0627 \u062f\u0631 \u0622\u06af\u0647\u06cc \u0627\u06cc\u0646 \u0645\u0648\u0642\u0639\u06cc\u062a \u0634\u063a\u0644\u06cc \u0645\u0634\u0627\u0647\u062f\u0647 \u06a9\u0646\u06cc\u062f. \u0645\u0634\u0627\u0647\u062f\u0647 \u0645\u0648\u0642\u0639\u06cc\u062a \u0634\u063a\u0644\u06cc \u06a9\u0627\u0631\u0634\u0646\u0627\u0633 [&hellip;]<\/p>\n","protected":false},"author":6,"featured_media":19273,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[22],"tags":[],"class_list":["post-19271","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-newss"],"acf":[],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v19.5 (Yoast SEO v19.10) - https:\/\/yoast.com\/wordpress\/plugins\/seo\/ -->\n<title>\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u06a9\u0627\u0631\u0634\u0646\u0627\u0633 \u0641\u0631\u0648\u0634 \u062f\u0631 \u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633 &raquo; \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/abadis-med.com\/\u0627\u0633\u062a\u062e\u062f\u0627\u0645-\u06a9\u0627\u0631\u0634\u0646\u0627\u0633-\u0641\u0631\u0648\u0634-\u062f\u0631-\u0634\u0631\u06a9\u062a-\u062f\u0627\u0646\u0634\u0628\u0646\u06cc\/\" \/>\n<meta property=\"og:locale\" content=\"fa_IR\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u06a9\u0627\u0631\u0634\u0646\u0627\u0633 \u0641\u0631\u0648\u0634 \u062f\u0631 \u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633 &raquo; \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633\" \/>\n<meta property=\"og:description\" content=\"\u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633 \u0628\u0631\u0627\u06cc \u062a\u06a9\u0645\u06cc\u0644 \u062a\u06cc\u0645 \u0641\u0631\u0648\u0634 \u062e\u0648\u062f \u0627\u0632 \u0639\u0644\u0627\u0642\u0647\u200c\u0645\u0646\u062f\u0627\u0646 \u0628\u0647 \u0641\u0639\u0627\u0644\u06cc\u062a \u062f\u0631 \u062d\u0648\u0632\u0647 \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u067e\u0632\u0634\u06a9\u06cc \u062f\u0639\u0648\u062a \u0628\u0647 \u0647\u0645\u06a9\u0627\u0631\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f. \u0627\u06af\u0631 \u062f\u0631 \u0628\u0631\u0642\u0631\u0627\u0631\u06cc \u0627\u0631\u062a\u0628\u0627\u0637 \u0628\u0627 \u0645\u0634\u062a\u0631\u06cc\u0627\u0646 \u0648 \u067e\u06cc\u06af\u06cc\u0631\u06cc \u0627\u0645\u0648\u0631 \u0641\u0631\u0648\u0634 \u062a\u0648\u0627\u0646\u0645\u0646\u062f \u0647\u0633\u062a\u06cc\u062f\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0634\u0631\u062d \u0648\u0638\u0627\u06cc\u0641\u060c \u0634\u0631\u0627\u06cc\u0637 \u0647\u0645\u06a9\u0627\u0631\u06cc \u0648 \u0631\u0648\u0634 \u0627\u0631\u0633\u0627\u0644 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0631\u0627 \u062f\u0631 \u0622\u06af\u0647\u06cc \u0627\u06cc\u0646 \u0645\u0648\u0642\u0639\u06cc\u062a \u0634\u063a\u0644\u06cc \u0645\u0634\u0627\u0647\u062f\u0647 \u06a9\u0646\u06cc\u062f. \u0645\u0634\u0627\u0647\u062f\u0647 \u0645\u0648\u0642\u063