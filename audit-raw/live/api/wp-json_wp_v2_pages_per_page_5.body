\/wp-json\/wp\/v2\/users\/6"}],"replies":[{"embeddable":true,"href":"https:\/\/abadis-med.com\/wp-json\/wp\/v2\/comments?post=18133"}],"version-history":[{"count":18,"href":"https:\/\/abadis-med.com\/wp-json\/wp\/v2\/pages\/18133\/revisions"}],"predecessor-version":[{"id":18464,"href":"https:\/\/abadis-med.com\/wp-json\/wp\/v2\/pages\/18133\/revisions\/18464"}],"wp:attachment":[{"href":"https:\/\/abadis-med.com\/wp-json\/wp\/v2\/media?parent=18133"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":17933,"date":"2025-08-04T08:54:32","date_gmt":"2025-08-04T08:54:32","guid":{"rendered":"https:\/\/abadis-med.com\/?page_id=17933"},"modified":"2025-12-03T05:54:24","modified_gmt":"2025-12-03T06:54:24","slug":"%d8%aa%d8%ac%d8%a7%d8%b1%d8%a8-%d9%85%d8%a7","status":"publish","type":"page","link":"https:\/\/abadis-med.com\/%d8%aa%d8%ac%d8%a7%d8%b1%d8%a8-%d9%85%d8%a7\/","title":{"rendered":"\u062a\u062c\u0627\u0631\u0628 \u0645\u0627"},"content":{"rendered":"\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"17933\" data-post-id=\"17933\" data-obj-id=\"17933\" class=\"elementor elementor-17933 dce-elementor-post-17933\">\n\t\t\t\t\t\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-cfe4a74 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"cfe4a74\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-01ef7ae\" data-id=\"01ef7ae\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-50905e2 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"50905e2\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-inner-column elementor-element elementor-element-587dee9\" data-id=\"587dee9\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t\t\t<div class=\"elementor-element elementor-element-8070f7b elementor-widget elementor-widget-heading\" data-id=\"8070f7b\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">\u062e\u0644\u0627\u0635\u0647 \u0642\u0627\u0646\u0648\u0646 \u062a\u062c\u0627\u0631\u062a \u0622\u0628\u0627\u062f\u06cc\u0633<\/h2>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-111e62c elementor-widget elementor-widget-text-editor\" data-id=\"111e62c\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<p data-start=\"148\" data-end=\"343\">\u0627\u06cc\u0646 \u0645\u062c\u0645\u0648\u0639\u0647 \u06cc\u06a9 \u0631\u0627\u0647\u0646\u0645\u0627\u06cc \u062c\u0627\u0645\u0639 \u0648 \u06a9\u0627\u0631\u0628\u0631\u062f\u06cc \u0627\u0632 \u0645\u0647\u0645\u200c\u062a\u0631\u06cc\u0646 \u0645\u0642\u0631\u0631\u0627\u062a \u0642\u0627\u0646\u0648\u0646 \u062a\u062c\u0627\u0631\u062a \u0627\u06cc\u0631\u0627\u0646 \u0627\u0633\u062a \u06a9\u0647 \u0628\u0627 \u0647\u062f\u0641 \u0627\u0631\u062a\u0642\u0627\u06cc \u0634\u0641\u0627\u0641\u06cc\u062a\u060c \u0627\u0646\u0637\u0628\u0627\u0642 \u062d\u0642\u0648\u0642\u06cc \u0648 \u0646\u0638\u0645 \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u062a\u0647\u06cc\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a. \u062f\u0631 \u0627\u06cc\u0646 \u0631\u0627\u0647\u0646\u0645\u0627 \u0645\u0648\u0627\u0631\u062f \u0632\u06cc\u0631 \u0628\u0647\u200c\u0637\u0648\u0631 \u062e\u0644\u0627\u0635\u0647 \u0627\u0631\u0627\u0626\u0647 \u0634\u062f\u0647\u200c\u0627\u0646\u062f:<\/p><ul data-start=\"345\" data-end=\"614\"><li data-start=\"345\" data-end=\"393\"><p data-start=\"347\" data-end=\"393\">\u0627\u0644\u0632\u0627\u0645\u0627\u062a \u062a\u0623\u0633\u06cc\u0633 \u0634\u0631\u06a9\u062a\u200c\u0647\u0627\u06cc \u0633\u0647\u0627\u0645\u06cc \u0648 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a \u0645\u062d\u062f\u0648\u062f<\/p><\/li><li data-start=\"394\" data-end=\"452\"><p data-start=\"396\" data-end=\"452\">\u0633\u0627\u062e\u062a\u0627\u0631 \u0648 \u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a \u0645\u062c\u0627\u0645\u0639 \u0639\u0645\u0648\u0645\u06cc (\u0645\u0624\u0633\u0633\u060c \u0639\u0627\u062f\u06cc\u060c \u0641\u0648\u0642\u200c\u0627\u0644\u0639\u0627\u062f\u0647)<\/p><\/li><li data-start=\"453\" data-end=\"495\"><p data-start=\"455\" data-end=\"495\">\u0648\u0638\u0627\u06cc\u0641 \u0648 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a\u200c\u0647\u0627\u06cc \u0647\u06cc\u0626\u062a\u200c\u0645\u062f\u06cc\u0631\u0647 \u0648 \u0628\u0627\u0632\u0631\u0633<\/p><\/li><li data-start=\"496\" data-end=\"527\"><p data-start=\"498\" data-end=\"527\">\u0645\u0642\u0631\u0631\u0627\u062a \u0627\u0641\u0632\u0627\u06cc\u0634 \u0648 \u06a9\u0627\u0647\u0634 \u0633\u0631\u0645\u0627\u06cc\u0647<\/p><\/li><li data-start=\"528\" data-end=\"567\"><p data-start=\"530\" data-end=\"567\">\u0642\u0648\u0627\u0639\u062f \u0627\u0646\u062d\u0644\u0627\u0644 \u0648 \u0627\u0644\u0632\u0627\u0645\u0627\u062a \u0642\u0627\u0646\u0648\u0646\u06cc \u0645\u0631\u062a\u0628\u0637<\/p><\/li><li data-start=\"568\" data-end=\"614\"><p data-start=\"570\" data-end=\"614\">\u062d\u062f\u0646\u0635\u0627\u0628\u200c\u0647\u0627\u060c \u0645\u0647\u0644\u062a\u200c\u0647\u0627 \u0648 \u0641\u0631\u0622\u06cc\u0646\u062f\u0647\u0627\u06cc \u0636\u0631\u0648\u0631\u06cc \u062d\u0642\u0648\u0642\u06cc<\/p><\/li><\/ul><p data-start=\"616\" data-end=\"682\"><strong data-start=\"616\" data-end=\"636\">\u06af\u0631\u062f\u0622\u0648\u0631\u06cc \u0648 \u062a\u062f\u0648\u06cc\u0646:<\/strong> <em data-start=\"637\" data-end=\"682\">\u0648\u0627\u062d\u062f \u062d\u0642\u0648\u0642\u06cc \u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633<\/em><\/p>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-643bd41 elementor-widget-divider--view-line elementor-widget elementor-widget-divider\" data-id=\"643bd41\" data-element_type=\"widget\" data-widget_type=\"divider.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-divider\">\n\t\t\t<span class=\"elementor-divider-separator\">\n\t\t\t\t\t\t<\/span>\n\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-fa70c14 elementor-widget elementor-widget-heading\" data-id=\"fa70c14\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">\u062f\u0633\u062a\u0648\u0631\u0627\u0644\u0639\u0645\u0644 \u062d\u0633\u0627\u0628\u0631\u0633\u06cc \u0628\u06cc\u0645\u0647 \u062a\u0623\u0645\u06cc\u0646 \u0627\u062c\u062a\u0645\u0627\u0639\u06cc<\/h2>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-a5534b8 elementor-widget elementor-widget-text-editor\" data-id=\"a5534b8\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<p data-start=\"177\" data-end=\"384\">\u0627\u06cc\u0646 \u062f\u0633\u062a\u0648\u0631\u0627\u0644\u0639\u0645\u0644 \u06a9\u0627\u0631\u0628\u0631\u062f\u06cc \u062a\u0648\u0633\u0637 <strong data-start=\"205\" data-end=\"251\">\u0648\u0627\u062d\u062f \u0645\u0627\u0644\u06cc \u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633<\/strong> \u06af\u0631\u062f\u0622\u0648\u0631\u06cc \u0634\u062f\u0647 \u0648 \u0628\u0647 \u0645\u062f\u06cc\u0631\u0627\u0646 \u06a9\u0645\u06a9 \u0645\u06cc\u200c\u06a9\u0646\u062f \u062a\u0627 \u0631\u06cc\u0633\u06a9 \u062c\u0631\u0627\u06cc\u0645 \u0628\u06cc\u0645\u0647\u200c\u0627\u06cc \u0631\u0627 \u06a9\u0627\u0647\u0634 \u062f\u0627\u062f\u0647 \u0648 \u0627\u0633\u0646\u0627\u062f \u062e\u0648\u062f \u0631\u0627 \u0645\u0637\u0627\u0628\u0642 \u0627\u0644\u0632\u0627\u0645\u0627\u062a \u0633\u0627\u0632\u0645\u0627\u0646 \u062a\u0623\u0645\u06cc\u0646 \u0627\u062c\u062a\u0645\u0627\u0639\u06cc \u0645\u062f\u06cc\u0631\u06cc\u062a \u06a9\u0646\u0646\u062f.<\/p><p data-start=\"386\" data-end=\"427\"><strong>\u0645\u0647\u0645\u200c\u062a\u0631\u06cc\u0646 \u0646\u06a9\u0627\u062a \u06a9\u0644\u06cc\u062f\u06cc \u062d\u0633\u0627\u0628\u0631\u0633\u06cc \u0628\u06cc\u0645\u0647:<\/strong><\/p><ul data-start=\"428\" data-end=\"1269\"><li data-start=\"428\" data-end=\"553\"><p data-start=\"430\" data-end=\"553\">\u062d\u0633\u0627\u0628\u0631\u0633\u06cc \u0628\u06cc\u0645\u0647\u200c\u0627\u06cc \u0641\u0642\u0637 \u0628\u0631\u0631\u0633\u06cc \u0644\u06cc\u0633\u062a \u0628\u06cc\u0645\u0647 \u0646\u06cc\u0633\u062a\u061b \u0628\u0644\u06a9\u0647 \u0634\u0627\u0645\u0644 <strong data-start=\"482\" data-end=\"546\">\u062a\u0645\u0627\u0645 \u0647\u0632\u06cc\u0646\u0647\u200c\u0647\u0627\u060c \u0642\u0631\u0627\u0631\u062f\u0627\u062f\u0647\u0627\u060c \u062d\u0645\u0644\u200c\u0648\u0646\u0642\u0644\u060c \u0633\u0627\u062e\u062a\u200c\u0648\u0633\u0627\u0632 \u0648 \u062f\u0641\u0627\u062a\u0631 \u0642\u0627\u0646\u0648\u0646\u06cc<\/strong> \u0627\u0633\u062a.<\/p><\/li><li data-start=\"554\" data-end=\"629\"><p data-start=\"556\" data-end=\"629\">\u0648\u062c\u0648\u062f \u062f\u0641\u0627\u062a\u0631 \u0642\u0627\u0646\u0648\u0646\u06cc \u067e\u0644\u0645\u067e\u200c\u0634\u062f\u0647 \u0628\u0631\u0627\u06cc \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 <strong data-start=\"599\" data-end=\"616\">\u0639\u0644\u06cc\u200c\u0627\u0644\u0631\u0623\u0633 \u0634\u062f\u0646<\/strong> \u0636\u0631\u0648\u0631\u06cc \u0627\u0633\u062a.<\/p><\/li><li data-start=\"630\" data-end=\"700\"><p data-start=\"632\" data-end=\"700\">\u062f\u0641\u0627\u062a\u0631 \u0628\u0627\u06cc\u062f \u062a\u0627 <strong data-start=\"646\" data-end=\"656\">\u06f1\u06f0 \u0633\u0627\u0644<\/strong> \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u0634\u0648\u0646\u062f (\u0637\u0628\u0642 \u062a\u0648\u0627\u0641\u0642 \u062c\u062f\u06cc\u062f: <strong data-start=\"687\" data-end=\"696\">\u06f1 \u0633\u0627\u0644<\/strong>).<\/p><\/li><li data-start=\"701\" data-end=\"781\"><p data-start=\"703\" data-end=\"781\">\u062f\u0631 \u062f\u0633\u062a\u0648\u0631\u0627\u0644\u0639\u0645\u0644 \u0631\u0633\u0645\u06cc\u060c \u0646\u0631\u062e\u200c\u0647\u0627\u06cc \u0628\u06cc\u0645\u0647 \u0628\u0631\u0627\u06cc \u0647\u0632\u06cc\u0646\u0647\u200c\u0647\u0627 \u0645\u0634\u062e\u0635 \u0627\u0633\u062a: <strong data-start=\"760\" data-end=\"778\">\u06f3\u06f0\u066a \u2013 \u06f1\u06f6\u066a \u2013 \u06f7\u066a<\/strong>.<\/p><\/li><li data-start=\"782\" data-end=\"868\"><p data-start=\"784\" data-end=\"868\">\u062a\u0646\u0647\u0627 <strong data-start=\"789\" data-end=\"813\">\u0647\u0632\u06cc\u0646\u0647\u200c\u0647\u0627\u06cc \u067e\u0631\u062f\u0627\u062e\u062a\u200c\u0634\u062f\u0647<\/strong> \u0645\u0634\u0645\u0648\u0644 \u0628\u06cc\u0645\u0647 \u0647\u0633\u062a\u0646\u062f\u060c \u0646\u0647 \u0630\u062e\u0627\u06cc\u0631 \u06cc\u0627 \u0647\u0632\u06cc\u0646\u0647\u200c\u0647\u0627\u06cc \u067e\u0631\u062f\u0627\u062e\u062a\u200c\u0646\u0634\u062f\u0647.<\/p><\/li><li data-start=\"869\" data-end=\"957\"><p data-start=\"871\" data-end=\"957\">\u0644\u06cc\u0633\u062a \u0628\u06cc\u0645\u0647 \u0628\u0627\u06cc\u062f \u0628\u0627 \u0627\u0633\u0646\u0627\u062f \u0647\u0632\u06cc\u0646\u0647 \u0647\u0645\u200c\u062e\u0648\u0627\u0646\u06cc \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u062f \u0648 \u0627\u0642\u0644\u0627\u0645 <strong data-start=\"929\" data-end=\"943\">\u0645\u0634\u0645\u0648\u0644\/\u0645\u0639\u0627\u0641<\/strong> \u062a\u0641\u06a9\u06cc\u06a9 \u0634\u0648\u0646\u062f.<\/p><\/li><li data-start=\"958\" data-end=\"1013\"><p data-start=\"960\" data-end=\"1013\">\u06a9\u0627\u0631\u06a9\u0631\u062f \u06a9\u0627\u0631\u06a9\u0646\u0627\u0646 \u062a\u0627 \u0633\u0642\u0641 \u0642\u0627\u0646\u0648\u0646\u06cc \u0631\u0648\u0632\u0627\u0646\u0647 \u0645\u0634\u0645\u0648\u0644 \u0628\u06cc\u0645\u0647 \u0627\u0633\u062a.<\/p><\/li><li data-start=\"1014\" data-end=\"1078\"><p data-start=\"1016\" data-end=\"1078\">\u062e\u0631\u06cc\u062f \u06a9\u0627\u0644\u0627 \u0628\u06cc\u0645\u0647 \u0646\u062f\u0627\u0631\u062f\u060c \u0627\u0645\u0627 <strong data-start=\"1042\" data-end=\"1063\">\u062a\u0645\u0627\u0645 \u062d\u0642\u200c\u0627\u0644\u0632\u062d\u0645\u0647\u200c\u0647\u0627<\/strong> \u0645\u0634\u0645\u0648\u0644 \u0647\u0633\u062a\u0646\u062f.<\/p><\/li><li data-start=\"1079\" data-end=\"1125\"><p data-start=\"1081\" data-end=\"1125\">\u062f\u0631\u06cc\u0627\u0641\u062a <strong data-start=\"1088\" data-end=\"1112\">\u0645\u0641\u0627\u0635\u0627\u062d\u0633\u0627\u0628 \u067e\u06cc\u0645\u0627\u0646\u06a9\u0627\u0631\u0627\u0646<\/strong> \u0636\u0631\u0648\u0631\u06cc \u0627\u0633\u062a.<\/p><\/li><li data-start=\"1126\" data-end=\"1192\"><p data-start=\"1128\" data-end=\"1192\">\u062f\u0631 \u0627\u0633\u0646\u0627\u062f \u0645\u0627\u0644\u06cc\u060c \u0645\u0628\u0644\u063a \u06a9\u0627\u0644\u0627 \u0648 \u062d\u0642\u200c\u0627\u0644\u0632\u062d\u0645\u0647 \u0628\u0627\u06cc\u062f <strong data-start=\"1170\" data-end=\"1185\">\u062c\u062f\u0627\u06af\u0627\u0646\u0647 \u062f\u0631\u062c<\/strong> \u0634\u0648\u062f.<\/p><\/li><li data-start=\"1193\" data-end=\"1269\"><p data-start=\"1195\" data-end=\"1269\">\u0647\u0645\u06a9\u0627\u0631\u06cc \u0645\u0646\u0627\u0633\u0628 \u0628\u0627 \u062d\u0633\u0627\u0628\u0631\u0633\u0627\u0646 \u062a\u0623\u0645\u06cc\u0646 \u0627\u062c\u062a\u0645\u0627\u0639\u06cc \u0628\u0627\u0639\u062b \u062a\u0639\u06cc\u06cc\u0646 \u0636\u0631\u0627\u06cc\u0628 \u0645\u0646\u0635\u0641\u0627\u0646\u0647\u200c\u062a\u0631 \u0645\u06cc\u200c\u0634\u0648\u062f.<\/p><\/li><\/ul><p data-start=\"1271\" data-end=\"1328\"><strong data-start=\"1271\" data-end=\"1283\">\u06af\u0631\u062f\u0622\u0648\u0631\u06cc:<\/strong> <em data-start=\"1284\" data-end=\"1328\">\u0648\u0627\u062d\u062f \u0645\u0627\u0644\u06cc \u0634\u0631\u06a9\u062a \u062f\u0627\u0646\u0634\u200c\u0628\u0646\u06cc\u0627\u0646 \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633<\/em><\/p>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>\u062e\u0644\u0627\u0635\u0647 \u0642\u0627\u0646\u0648\u0646 \u062a\u062c\u0627\u0631\u062a \u0622\u0628\u0627\u062f\u06cc\u0633 \u0627\u06cc\u0646 \u0645\u062c\u0645\u0648\u0639\u0647 \u06cc\u06a9 \u0631\u0627\u0647\u0646\u0645\u0627\u06cc \u062c\u0627\u0645\u0639 \u0648 \u06a9\u0627\u0631\u0628\u0631\u062f\u06cc \u0627\u0632 \u0645\u0647\u0645\u200c\u062a\u0631\u06cc\u0646 \u0645\u0642\u0631\u0631\u0627\u062a \u0642\u0627\u0646\u0648\u0646 \u062a\u062c\u0627\u0631\u062a \u0627\u06cc\u0631\u0627\u0646 \u0627\u0633\u062a \u06a9\u0647 \u0628\u0627 \u0647\u062f\u0641 \u0627\u0631\u062a\u0642\u0627\u06cc \u0634\u0641\u0627\u0641\u06cc\u062a\u060c \u0627\u0646\u0637\u0628\u0627\u0642 \u062d\u0642\u0648\u0642\u06cc \u0648 \u0646\u0638\u0645 \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u062a\u0647\u06cc\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a. \u062f\u0631 \u0627\u06cc\u0646 \u0631\u0627\u0647\u0646\u0645\u0627 \u0645\u0648\u0627\u0631\u062f \u0632\u06cc\u0631 \u0628\u0647\u200c\u0637\u0648\u0631 \u062e\u0644\u0627\u0635\u0647 \u0627\u0631\u0627\u0626\u0647 \u0634\u062f\u0647\u200c\u0627\u0646\u062f: \u0627\u0644\u0632\u0627\u0645\u0627\u062a \u062a\u0623\u0633\u06cc\u0633 \u0634\u0631\u06a9\u062a\u200c\u0647\u0627\u06cc \u0633\u0647\u0627\u0645\u06cc \u0648 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a \u0645\u062d\u062f\u0648\u062f \u0633\u0627\u062e\u062a\u0627\u0631 \u0648 \u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a \u0645\u062c\u0627\u0645\u0639 \u0639\u0645\u0648\u0645\u06cc (\u0645\u0624\u0633\u0633\u060c \u0639\u0627\u062f\u06cc\u060c \u0641\u0648\u0642\u200c\u0627\u0644\u0639\u0627\u062f\u0647) [&hellip;]<\/p>\n","protected":false},"author":6,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"elementor_header_footer","meta":{"footnotes":""},"class_list":["post-17933","page","type-page","status-publish","hentry"],"acf":[],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v19.5 (Yoast SEO v19.10) - https:\/\/yoast.com\/wordpress\/plugins\/seo\/ -->\n<title>\u062a\u062c\u0627\u0631\u0628 \u0645\u0627 &raquo; \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/abadis-med.com\/\u062a\u062c\u0627\u0631\u0628-\u0645\u0627\/\" \/>\n<meta property=\"og:locale\" content=\"fa_IR\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"\u062a\u062c\u0627\u0631\u0628 \u0645\u0627 &raquo; \u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633\" \/>\n<meta property=\"og:description\" content=\"\u062e\u0644\u0627\u0635\u0647 \u0642\u0627\u0646\u0648\u0646 \u062a\u062c\u0627\u0631\u062a \u0622\u0628\u0627\u062f\u06cc\u0633 \u0627\u06cc\u0646 \u0645\u062c\u0645\u0648\u0639\u0647 \u06cc\u06a9 \u0631\u0627\u0647\u0646\u0645\u0627\u06cc \u062c\u0627\u0645\u0639 \u0648 \u06a9\u0627\u0631\u0628\u0631\u062f\u06cc \u0627\u0632 \u0645\u0647\u0645\u200c\u062a\u0631\u06cc\u0646 \u0645\u0642\u0631\u0631\u0627\u062a \u0642\u0627\u0646\u0648\u0646 \u062a\u062c\u0627\u0631\u062a \u0627\u06cc\u0631\u0627\u0646 \u0627\u0633\u062a \u06a9\u0647 \u0628\u0627 \u0647\u062f\u0641 \u0627\u0631\u062a\u0642\u0627\u06cc \u0634\u0641\u0627\u0641\u06cc\u062a\u060c \u0627\u0646\u0637\u0628\u0627\u0642 \u062d\u0642\u0648\u0642\u06cc \u0648 \u0646\u0638\u0645 \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u062a\u0647\u06cc\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a. \u062f\u0631 \u0627\u06cc\u0646 \u0631\u0627\u0647\u0646\u0645\u0627 \u0645\u0648\u0627\u0631\u062f \u0632\u06cc\u0631 \u0628\u0647\u200c\u0637\u0648\u0631 \u062e\u0644\u0627\u0635\u0647 \u0627\u0631\u0627\u0626\u0647 \u0634\u062f\u0647\u200c\u0627\u0646\u062f: \u0627\u0644\u0632\u0627\u0645\u0627\u062a \u062a\u0623\u0633\u06cc\u0633 \u0634\u0631\u06a9\u062a\u200c\u0647\u0627\u06cc \u0633\u0647\u0627\u0645\u06cc \u0648 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a \u0645\u062d\u062f\u0648\u062f \u0633\u0627\u062e\u062a\u0627\u0631 \u0648 \u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a \u0645\u062c\u0627\u0645\u0639 \u0639\u0645\u0648\u0645\u06cc (\u0645\u0624\u0633\u0633\u060c \u0639\u0627\u062f\u06cc\u060c \u0641\u0648\u0642\u200c\u0627\u0644\u0639\u0627\u062f\u0647) [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/abadis-med.com\/\u062a\u062c\u0627\u0631\u0628-\u0645\u0627\/\" \/>\n<meta property=\"og:site_name\" content=\"\u0645\u062e\u0627\u0632\u0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633\" \/>\n<meta property=\"article:publisher\" content=\"https:\