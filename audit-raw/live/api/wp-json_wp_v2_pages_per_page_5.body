0646 \u0637\u0628\u06cc \u0622\u0628\u0627\u062f\u06cc\u0633<\/strong>\u060c \u0628\u0647\u200c\u0639\u0646\u0648\u0627\u0646 \u067e\u06cc\u0634\u0631\u0648 \u062f\u0631 \u062a\u0648\u0644\u06cc\u062f <strong>\u06a9\u06cc\u0633\u0647\u200c\u0647\u0627\u06cc \u0633\u0627\u06a9\u0634\u0646 \u06cc\u06a9\u200c\u0628\u0627\u0631\u0645\u0635\u0631\u0641<\/strong> \u062f\u0631 \u0627\u06cc\u0631\u0627\u0646\u060c \u0645\u062a\u0639\u0647\u062f \u0627\u0633\u062a \u0641\u0639\u0627\u0644\u06cc\u062a\u200c\u0647\u0627\u06cc \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u0631\u0627\u0633\u062a\u0627\u06cc <strong>\u0627\u0647\u062f\u0627\u0641 \u062a\u0648\u0633\u0639\u0647 \u067e\u0627\u06cc\u062f\u0627\u0631 \u0633\u0627\u0632\u0645\u0627\u0646 \u0645\u0644\u0644 \u0645\u062a\u062d\u062f<\/strong><strong> (UN SDGs)<\/strong> \u0647\u062f\u0627\u06cc\u062a \u06a9\u0646\u062f.<br \/>\u0645\u0627 \u0628\u0627\u0648\u0631 \u062f\u0627\u0631\u06cc\u0645 \u06a9\u0647 \u062a\u0648\u0633\u0639\u0647 \u0635\u0646\u0639\u062a\u06cc \u062a\u0646\u0647\u0627 \u0632\u0645\u0627\u0646\u06cc \u0627\u0631\u0632\u0634\u0645\u0646\u062f \u0627\u0633\u062a \u06a9\u0647 \u062f\u0631 \u06a9\u0646\u0627\u0631 \u0627\u0631\u062a\u0642\u0627\u06cc \u0633\u0644\u0627\u0645\u062a \u062c\u0627\u0645\u0639\u0647\u060c \u0645\u0646\u062c\u0631 \u0628\u0647 <strong>\u062d\u0641\u0638 \u0645\u0646\u0627\u0628\u0639 \u0637\u0628\u06cc\u0639\u06cc\u060c \u06a9\u0627\u0647\u0634 \u0627\u062b\u0631\u0627\u062a \u0632\u06cc\u0633\u062a\u200c\u0645\u062d\u06cc\u0637\u06cc \u0648 \u062a\u0631\u0648\u06cc\u062c \u0641\u0631\u0647\u0646\u06af \u0645\u0635\u0631\u0641 \u0645\u0633\u0626\u0648\u0644\u0627\u0646\u0647<\/strong> \u0634\u0648\u062f.<\/p>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-31f3608 elementor-section-boxed elementor-section-height-d